{%- comment -%}
  Inline SVG icons. Usage: {% render 'icon', name: 'bag', class: 'icon' %}
  Social icons are simplified generic glyphs, not official logos.
{%- endcomment -%}
{%- liquid
  assign cls = class | default: 'icon'
  assign sw = stroke | default: 1.5
-%}
{%- case name -%}
  {%- when 'logo-mark' -%}
    <svg class="{{ cls }}" viewBox="0 0 36 20" fill="none" aria-hidden="true" focusable="false"><path d="M1 18.5 11 5.5l5.5 7L22 3l13 15.5" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round"/><path d="M1 18.5h34" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity=".45"/></svg>
  {%- when 'payment-generic' -%}
    <svg class="{{ cls }}" viewBox="0 0 38 24" aria-hidden="true" focusable="false"><rect x=".5" y=".5" width="37" height="23" rx="3.5" fill="none" stroke="currentColor" opacity=".3"/></svg>
  {%- else -%}
    <svg class="{{ cls }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ sw }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      {%- case name -%}
        {%- when 'search' -%}<circle cx="11" cy="11" r="6.5"/><path d="m20 20-4.2-4.2"/>
        {%- when 'account' -%}<circle cx="12" cy="8.5" r="3.75"/><path d="M4.5 20c1.2-3.6 4-5.25 7.5-5.25S18.3 16.4 19.5 20"/>
        {%- when 'bag' -%}<path d="M5.5 8h13l-1 12.25h-11L5.5 8Z"/><path d="M9 10V6.75a3 3 0 0 1 6 0V10"/>
        {%- when 'menu' -%}<path d="M4 8h16M4 16h16"/>
        {%- when 'close' -%}<path d="M6 6l12 12M18 6 6 18"/>
        {%- when 'plus' -%}<path d="M12 5v14M5 12h14"/>
        {%- when 'minus' -%}<path d="M5 12h14"/>
        {%- when 'arrow' -%}<path d="M5 12h14M13 6l6 6-6 6"/>
        {%- when 'chevron' -%}<path d="m6 9 6 6 6-6"/>
        {%- when 'check' -%}<path d="m5 12.5 4.5 4.5L19 7.5"/>
        {%- when 'moon' -%}<path d="M19.5 14.5A7.5 7.5 0 0 1 9.5 4.5a7.5 7.5 0 1 0 10 10Z"/>
        {%- when 'layers' -%}<path d="m12 4 8.5 4.5L12 13 3.5 8.5 12 4Z"/><path d="m3.5 12.5 8.5 4.5 8.5-4.5M3.5 16.5 12 21l8.5-4.5"/>
        {%- when 'spark' -%}<path d="M12 3.5v4M12 16.5v4M3.5 12h4M16.5 12h4M6 6l2.5 2.5M15.5 15.5 18 18M6 18l2.5-2.5M15.5 8.5 18 6"/>
        {%- when 'plane' -%}<path d="M10.5 13.5 4 11l1.5-1.5 7 1 4-4.5c.8-.8 2.2-1 2.7-.5s.3 1.9-.5 2.7l-4.5 4 1 7L13.7 21l-2.5-6.5L8 17.5V20l-1.5 1-1-3.5L2 16.5 3 15h2.5l3-3"/>
        {%- when 'bed' -%}<path d="M3 18V7M3 14h18v4M21 14v-2.5A2.5 2.5 0 0 0 18.5 9H11v5"/><circle cx="7" cy="11" r="1.75"/>
        {%- when 'car' -%}<path d="M4 16v-3.5L6 8h12l2 4.5V16H4Z"/><circle cx="7.5" cy="16.5" r="1.75"/><circle cx="16.5" cy="16.5" r="1.75"/>
        {%- when 'briefcase' -%}<rect x="3.5" y="7.5" width="17" height="12" rx="2"/><path d="M9 7.5V6a1.5 1.5 0 0 1 1.5-1.5h3A1.5 1.5 0 0 1 15 6v1.5M3.5 12.5h17"/>
        {%- when 'circle' -%}<circle cx="12" cy="12" r="7.5"/>
        {%- when 'box' -%}<path d="m12 3 8 4.5v9L12 21l-8-4.5v-9L12 3Z"/><path d="m4 7.5 8 4.5 8-4.5M12 12v9"/>
        {%- when 'instagram' -%}<rect x="4" y="4" width="16" height="16" rx="4.5"/><circle cx="12" cy="12" r="3.75"/><circle cx="17" cy="7" r=".6" fill="currentColor"/>
        {%- when 'tiktok' -%}<path d="M14 4v10.5a3.5 3.5 0 1 1-3.5-3.5"/><path d="M14 4c.4 2.6 2.1 4.2 5 4.5"/>
        {%- when 'pinterest' -%}<circle cx="12" cy="12" r="8.5"/><path d="M11 9.5c0-1.5 3.5-2 4 .5.4 2-1 4-2.6 3.7-1-.2-1.2-1.2-1.2-1.2L9.5 20"/>
        {%- when 'facebook' -%}<path d="M14 8h2.5V4.5H14A3.5 3.5 0 0 0 10.5 8v2.5H8V14h2.5v6.5H14V14h2.5l.5-3.5h-3V8Z"/>
        {%- when 'youtube' -%}<rect x="3" y="6" width="18" height="12" rx="3.5"/><path d="m10.5 9.5 4 2.5-4 2.5v-5Z"/>
      {%- endcase -%}
    </svg>
{%- endcase -%}
