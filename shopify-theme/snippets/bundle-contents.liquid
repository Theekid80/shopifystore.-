{%- comment -%}
  "What's included" for a bundle, from Shopify data:
    1. metafield custom.bundle_components (list of product references) — linked, with thumbnails
    2. otherwise metafield custom.whats_included (one item per line)
  Renders nothing if neither is set.
{%- endcomment -%}
{%- assign components = product.metafields.custom.bundle_components.value -%}
{%- if components.size > 0 -%}
  <ul class="included" role="list">
    {%- for c in components -%}
      <li>
        <span class="included__thumb media">
          {%- if c.featured_media -%}{{ c.featured_media | image_url: width: 120 | image_tag: loading: 'lazy', alt: '', widths: '60, 120' }}{%- endif -%}
        </span>
        <a href="{{ c.url }}">{{ c.title | escape }}</a>
      </li>
    {%- endfor -%}
  </ul>
{%- elsif product.metafields.custom.whats_included != blank -%}
  {%- assign lines = product.metafields.custom.whats_included.value | newline_to_br | split: '<br />' -%}
  <ul class="bundle-card__list" role="list">
    {%- for line in lines -%}
      {%- assign l = line | strip -%}
      {%- if l != blank -%}<li>{% render 'icon', name: 'check' %}{{ l | escape }}</li>{%- endif -%}
    {%- endfor -%}
  </ul>
{%- endif -%}
