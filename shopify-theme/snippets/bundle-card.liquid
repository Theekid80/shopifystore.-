{%- comment -%}
  Bundle card. Contents come from the bundle product's metafield
  `custom.bundle_components` (list of product references) — so the pieces
  inside each bundle can change in Shopify Admin without touching code.
  If that isn't set, `custom.whats_included` (one item per line) is used.

  The crossed-out price is the real total of the component products'
  current prices ("if bought separately"), only when that total is higher.

  Params:
    product    bundle product
    featured   true → dark, emphasized card (the complete system)
    fallback_title / fallback_text  used in the theme editor when no product
{%- endcomment -%}
{%- liquid
  assign components = product.metafields.custom.bundle_components.value
  assign separate_total = 0
  for c in components
    assign separate_total = separate_total | plus: c.price
  endfor
  assign compare_label = nil
  if separate_total > product.price
    assign compare_label = 'products.product.bought_separately' | t
  else
    assign separate_total = nil
  endif
-%}
{%- if product == blank or product.title == blank -%}
  <article class="bundle-card{% if featured %} bundle-card--featured{% endif %}">
    <div class="media media--landscape">{{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
    <div class="bundle-card__body">
      <p class="eyebrow accent">{{ 'general.coming_soon' | t }}</p>
      <h3 class="h-title">{{ fallback_title | default: 'Bundle' }}</h3>
      {%- if fallback_text != blank -%}<p class="small muted">{{ fallback_text }}</p>{%- endif -%}
      {%- if request.design_mode -%}<p class="xsmall muted">{{ 'general.placeholder_editor' | t }}</p>{%- endif -%}
    </div>
  </article>
{%- else -%}
  <article class="bundle-card{% if featured %} bundle-card--featured{% endif %}">
    <a href="{{ product.url }}" tabindex="-1" aria-hidden="true">
      <div class="media media--landscape media--zoom">
        {%- if product.featured_media -%}
          {%- render 'responsive-image', image: product.featured_media.preview_image, alt: '', sizes: '(min-width: 990px) 30vw, 90vw' -%}
        {%- else -%}
          {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
    </a>
    <div class="bundle-card__body">
      <div style="display:flex; justify-content:space-between; gap:1rem; align-items:center;">
        <p class="eyebrow accent">
          {%- if components.size > 0 -%}{{ 'products.product.pieces' | t: count: components.size }}{%- else -%}{{ 'products.product.whats_included' | t }}{%- endif -%}
        </p>
        {% render 'product-badge', product: product, class: 'badge--soft' %}
      </div>
      <h3 class="h-title"><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
      {%- if product.metafields.custom.short_description != blank -%}
        <p class="small muted">{{ product.metafields.custom.short_description.value | escape }}</p>
      {%- endif -%}

      {%- if components.size > 0 -%}
        <ul class="bundle-card__list">
          {%- for c in components -%}
            <li>{% render 'icon', name: 'check' %}<a href="{{ c.url }}">{{ c.title | escape }}</a></li>
          {%- endfor -%}
        </ul>
      {%- elsif product.metafields.custom.whats_included != blank -%}
        <ul class="bundle-card__list">
          {%- assign lines = product.metafields.custom.whats_included.value | newline_to_br | split: '<br />' -%}
          {%- for line in lines -%}
            {%- assign l = line | strip -%}
            {%- if l != blank -%}<li>{% render 'icon', name: 'check' %}{{ l | escape }}</li>{%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      <div class="bundle-card__footer">
        {% render 'price', product: product, compare: separate_total, compare_label: compare_label %}
        <a href="{{ product.url }}" class="btn {% if featured %}btn--light{% else %}btn--primary{% endif %}">
          {{ 'products.product.view_product' | t }}
          {% render 'icon', name: 'arrow', class: 'icon-arrow' %}
        </a>
      </div>
    </div>
  </article>
{%- endif -%}
