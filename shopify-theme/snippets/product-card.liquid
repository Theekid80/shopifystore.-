{%- comment -%}
  Reusable product card — all data comes from the Shopify product.

  Params:
    product     product object (blank → placeholder card in the theme editor)
    index       optional label shown top-left (e.g. "01")
    sizes       image sizes attribute
    priority    true for above-the-fold cards
    quick_add   override settings.card_show_quick_add

  Supports: image + hover image, name, price / compare-at, badge, color
  swatches, variant selection, Quick Add (Shopify cart), View Product.
  Quick Add is hidden while pre-launch mode is on, for "coming soon"
  products, and for sold-out products.
{%- endcomment -%}
{%- liquid
  assign sizes = sizes | default: '(min-width: 990px) 30vw, (min-width: 750px) 40vw, 72vw'
  assign ratio = settings.card_image_ratio | default: 'square'
  if quick_add == nil
    assign quick_add = settings.card_show_quick_add
  endif

  assign coming_soon = false
  if product.metafields.custom.coming_soon.value == true or product.tags contains 'coming-soon'
    assign coming_soon = true
  endif
  assign can_buy = false
  if settings.prelaunch_mode == false and coming_soon == false and product.available
    assign can_buy = true
  endif

  assign color_option = nil
  for option in product.options_with_values
    assign opt = option.name | downcase
    if opt == 'color' or opt == 'colour'
      assign color_option = option
    endif
  endfor
  assign form_id = 'QuickAdd-' | append: section.id | append: '-' | append: product.id
-%}

{%- if product == blank or product.title == blank -%}
  <article class="card card--placeholder">
    <div class="media media--{{ ratio }}">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
    <div class="card__info">
      <div class="card__title-row">
        <h3 class="card__title">{{ 'general.coming_soon' | t }}</h3>
      </div>
      {%- if request.design_mode -%}<p class="card__text">{{ 'general.placeholder_editor' | t }}</p>{%- endif -%}
    </div>
  </article>
{%- else -%}
  <article class="card" data-product-id="{{ product.id }}">
    <div class="card__media-wrap" style="position: relative;">
      <a href="{{ product.url }}" class="card__media" tabindex="-1" aria-hidden="true">
        <div class="media media--{{ ratio }} media--zoom">
          {%- if product.featured_media -%}
            {%- render 'responsive-image', image: product.featured_media.preview_image, alt: '', sizes: sizes, priority: priority, widths: '360, 540, 720, 900, 1080' -%}
            {%- if settings.card_show_secondary_image and product.media[1] -%}
              {%- render 'responsive-image', image: product.media[1].preview_image, alt: '', sizes: sizes, widths: '360, 540, 720, 900, 1080' -%}
            {%- endif -%}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
      </a>
      <div class="card__badges">
        <span>{% if index != blank %}<span class="badge">{{ index }}</span>{% endif %}</span>
        <span>{% render 'product-badge', product: product, class: 'badge--dark' %}</span>
      </div>
      {%- if can_buy and quick_add -%}
        <div class="card__quick-add">
          <button type="submit" form="{{ form_id }}" class="btn" aria-label="{{ 'products.product.quick_add' | t }}: {{ product.title | escape }}">
            {% render 'icon', name: 'plus', class: 'icon-arrow' %}
            <span data-button-label>{{ 'products.product.quick_add' | t }}</span>
          </button>
        </div>
      {%- endif -%}
    </div>

    <div class="card__info">
      <div class="card__title-row">
        <h3 class="card__title"><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
        <div class="card__price">{% render 'price', product: product, show_from: true %}</div>
      </div>
      {%- liquid
        if product.metafields.custom.short_description != blank
          assign card_text = product.metafields.custom.short_description.value
        else
          assign card_text = product.description | strip_html | truncatewords: 14
        endif
      -%}
      {%- if card_text != blank -%}<p class="card__text">{{ card_text | escape }}</p>{%- endif -%}

      <div class="card__footer">
        {%- if can_buy and product.has_only_default_variant == false -%}
          <label class="visually-hidden" for="{{ form_id }}-variant">{{ 'products.product.choose' | t: option: product.options.first }}</label>
          <select id="{{ form_id }}-variant" name="id" form="{{ form_id }}" class="card__select">
            {%- for variant in product.variants -%}
              <option value="{{ variant.id }}" {% unless variant.available %}disabled{% endunless %} {% if variant == product.selected_or_first_available_variant %}selected{% endif %}>
                {{ variant.title | escape }}{% unless variant.available %} — {{ 'products.product.sold_out' | t }}{% endunless %}
              </option>
            {%- endfor -%}
          </select>
        {%- elsif settings.card_show_swatches and color_option -%}
          <ul class="swatches list-unstyled" aria-label="{{ color_option.name | escape }}">
            {%- for value in color_option.values limit: 6 -%}
              {%- liquid
                if value.swatch.color
                  assign swatch = value.swatch.color
                else
                  assign swatch = value | handleize | replace: '-', ''
                endif
              -%}
              <li class="swatch" style="--swatch: {{ swatch }};" title="{{ value | escape }}"><span class="visually-hidden">{{ value | escape }}</span></li>
            {%- endfor -%}
          </ul>
        {%- else -%}
          <span></span>
        {%- endif -%}
        <a class="card__view" href="{{ product.url }}">{{ 'products.product.view_product' | t }}<span class="visually-hidden">: {{ product.title | escape }}</span></a>
      </div>
    </div>

    {%- if can_buy and quick_add -%}
      {%- form 'product', product, id: form_id, data-product-form: '', class: 'visually-hidden', novalidate: 'novalidate' -%}
        {%- if product.has_only_default_variant -%}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        {%- endif -%}
        <input type="hidden" name="quantity" value="1">
        <p class="product-form__error" role="alert" data-form-error hidden></p>
      {%- endform -%}
    {%- endif -%}
  </article>
{%- endif -%}
