{%- comment -%} Theme block: rich text, optional eyebrow. {%- endcomment -%}
<div class="stack-sm" {{ block.shopify_attributes }}>
  {%- if block.settings.eyebrow != blank -%}<p class="eyebrow accent">{{ block.settings.eyebrow | escape }}</p>{%- endif -%}
  <div class="rte">{{ block.settings.text }}</div>
</div>

{% schema %}
{
  "name": "Text",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Comfort for the journey.</p>" }
  ],
  "presets": [{ "name": "Text" }]
}
{% endschema %}
