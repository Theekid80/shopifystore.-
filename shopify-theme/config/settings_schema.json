[
  {
    "name": "theme_info",
    "theme_name": "VELARA",
    "theme_version": "1.0.0",
    "theme_author": "VELARA",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://help.shopify.com/"
  },
  {
    "name": "Brand",
    "settings": [
      {
        "type": "paragraph",
        "content": "The brand name is used across the theme (header, footer, page titles, structured data). Change it here if you rename the brand. Product titles and descriptions are edited in Products."
      },
      {
        "type": "text",
        "id": "brand_name",
        "label": "Brand name",
        "default": "VELARA"
      },
      {
        "type": "text",
        "id": "brand_tagline",
        "label": "Tagline",
        "default": "Better Sleep. Smoother Journeys."
      },
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo image",
        "info": "Optional. Without a logo image, the brand name is shown as a wordmark."
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "Logo width",
        "min": 60,
        "max": 240,
        "step": 4,
        "unit": "px",
        "default": 120
      },
      {
        "type": "checkbox",
        "id": "show_logo_mark",
        "label": "Show mountain mark beside the wordmark",
        "default": true
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "Square PNG, at least 64 \u00d7 64px."
      }
    ]
  },
  {
    "name": "Store status",
    "settings": [
      {
        "type": "paragraph",
        "content": "Pre-launch mode replaces every Add to Cart / Buy Now with a Coming Soon state and an email sign-up, so the store never takes orders before products, pricing, shipping and fulfillment are confirmed. Turn it off only when you're ready to sell."
      },
      {
        "type": "checkbox",
        "id": "prelaunch_mode",
        "label": "Pre-launch mode (no purchases)",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "prelaunch_hide_prices",
        "label": "Hide prices until launch",
        "info": "Shows \"Price coming soon\" instead of prices while pre-launch mode is on. Turn off to preview prices.",
        "default": true
      },
      {
        "type": "text",
        "id": "prelaunch_button_label",
        "label": "Pre-launch button label",
        "default": "Coming soon"
      },
      {
        "type": "text",
        "id": "prelaunch_message",
        "label": "Pre-launch message on product pages",
        "default": "Launching soon. Join the list to hear first when it's available."
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_background",
        "label": "Background (warm ivory)",
        "default": "#FAF8F4"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Surface (off-white)",
        "default": "#F4F1EC"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text (charcoal)",
        "default": "#1C1C1B"
      },
      {
        "type": "color",
        "id": "color_muted",
        "label": "Secondary text",
        "default": "#6F6B65"
      },
      {
        "type": "color",
        "id": "color_dark",
        "label": "Dark sections",
        "default": "#0E0E0E"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent (taupe, for text)",
        "default": "#8C775D"
      },
      {
        "type": "color",
        "id": "color_accent_light",
        "label": "Accent (champagne)",
        "default": "#C9B89F"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Borders",
        "default": "#E6E2DC"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "checkbox",
        "id": "use_brand_fonts",
        "label": "Use VELARA fonts (Cormorant Garamond + Manrope)",
        "info": "Bundled with the theme. Turn off to use the fonts picked below.",
        "default": true
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "label": "Heading font",
        "default": "assistant_n4"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "Body font",
        "default": "assistant_n4"
      },
      {
        "type": "range",
        "id": "heading_scale",
        "label": "Heading size",
        "min": 80,
        "max": 130,
        "step": 5,
        "unit": "%",
        "default": 100
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart type",
        "options": [
          {
            "value": "drawer",
            "label": "Drawer"
          },
          {
            "value": "page",
            "label": "Page"
          }
        ],
        "default": "drawer"
      },
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Free-shipping threshold (store currency)",
        "info": "Leave empty to hide the free-shipping progress bar. Only set this once the same rule exists in Settings \u2192 Shipping and delivery."
      },
      {
        "type": "checkbox",
        "id": "cart_show_note",
        "label": "Show order note on cart page",
        "default": false
      }
    ]
  },
  {
    "name": "Product cards",
    "settings": [
      {
        "type": "select",
        "id": "card_image_ratio",
        "label": "Image shape",
        "options": [
          {
            "value": "square",
            "label": "Square"
          },
          {
            "value": "portrait",
            "label": "Portrait"
          }
        ],
        "default": "square"
      },
      {
        "type": "checkbox",
        "id": "card_show_secondary_image",
        "label": "Show second image on hover",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_quick_add",
        "label": "Show Quick Add",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_swatches",
        "label": "Show color swatches",
        "default": true
      }
    ]
  },
  {
    "name": "Product imagery",
    "settings": [
      {
        "type": "checkbox",
        "id": "show_concept_labels",
        "label": "Label bundled concept images",
        "info": "The theme ships with concept images for lifestyle sections. While this is on, each shows a small \"Concept image\" label. Replace them with real photography in each section, then turn this off.",
        "default": true
      },
      {
        "type": "paragraph",
        "content": "For products whose images are concept renderings (not photos of the final product), set the product metafield custom.concept_imagery to true. The notice below is then shown under that product's images."
      },
      {
        "type": "text",
        "id": "concept_image_notice",
        "label": "Concept imagery notice",
        "default": "Images shown are concept renderings. The final product may differ."
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "url",
        "id": "social_instagram_link",
        "label": "Instagram"
      },
      {
        "type": "url",
        "id": "social_tiktok_link",
        "label": "TikTok"
      },
      {
        "type": "url",
        "id": "social_pinterest_link",
        "label": "Pinterest"
      },
      {
        "type": "url",
        "id": "social_facebook_link",
        "label": "Facebook"
      },
      {
        "type": "url",
        "id": "social_youtube_link",
        "label": "YouTube"
      }
    ]
  },
  {
    "name": "Search engine & sharing",
    "settings": [
      {
        "type": "image_picker",
        "id": "share_image",
        "label": "Default social sharing image",
        "info": "1200 \u00d7 630px. Used when a page has no image of its own."
      }
    ]
  }
]