{%- liquid
  assign brand = settings.brand_name | default: shop.name
  assign menu = linklists[section.settings.menu]
  assign overlay = false
  if section.settings.overlay_on_home and request.page_type == 'index'
    assign overlay = true
  endif
-%}

{%- capture fallback_links -%}
  {{ routes.all_products_collection_url }}|Shop,/collections/sleep|Sleep,/collections/travel-organization|Organize,/collections/bundles|Bundles,/pages/about|About,/pages/faq|FAQ
{%- endcapture -%}
{%- assign fallback_links = fallback_links | strip | split: ',' -%}

<header class="header{% if overlay %} header--overlay{% endif %}" data-header {{ section.shopify_attributes }}>
  <div class="page-width header__inner">
    <button type="button" class="header__icon header__menu-toggle" data-drawer-open="MenuDrawer" aria-controls="MenuDrawer" aria-expanded="false" aria-label="{{ 'general.menu.open' | t }}">
      {% render 'icon', name: 'menu' %}
    </button>

    <a href="{{ routes.root_url }}" class="header__logo" aria-label="{{ brand | escape }}">
      {%- if settings.logo != blank -%}
        {{ settings.logo | image_url: width: 480 | image_tag: class: 'header__logo-img', alt: brand, widths: '160, 240, 320, 480', sizes: '240px', loading: 'eager' }}
      {%- else -%}
        {%- if settings.show_logo_mark -%}{% render 'icon', name: 'logo-mark', class: 'logo-mark' %}{%- endif -%}
        <span class="wordmark">{{ brand | escape }}</span>
      {%- endif -%}
    </a>

    <nav class="header__nav" aria-label="Main">
      <ul class="header__menu eyebrow" role="list">
        {%- if menu.links.size > 0 -%}
          {%- for link in menu.links -%}
            <li><a href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %}>{{ link.title | escape }}</a></li>
          {%- endfor -%}
        {%- else -%}
          {%- for item in fallback_links -%}
            {%- assign parts = item | split: '|' -%}
            <li><a href="{{ parts[0] }}" {% if request.path == parts[0] %}aria-current="page"{% endif %}>{{ parts[1] }}</a></li>
          {%- endfor -%}
        {%- endif -%}
      </ul>
    </nav>

    <div class="header__icons">
      <button type="button" class="header__icon header__icon--desktop" data-drawer-open="SearchModal" aria-controls="SearchModal" aria-expanded="false" aria-label="{{ 'general.search.label' | t }}">
        {% render 'icon', name: 'search' %}
      </button>
      {%- if shop.customer_accounts_enabled -%}
        <a href="{{ routes.account_url }}" class="header__icon header__icon--desktop" aria-label="{{ 'general.account' | t }}">{% render 'icon', name: 'account' %}</a>
      {%- endif -%}
      <a href="{{ routes.cart_url }}" class="header__icon" {% if settings.cart_type == 'drawer' %}data-drawer-open="CartDrawer" aria-controls="CartDrawer" aria-expanded="false"{% endif %} aria-label="{{ 'accessibility.cart_count' | t: count: cart.item_count }}">
        {% render 'icon', name: 'bag' %}
        <span class="cart-count" data-cart-count aria-hidden="true">{% if cart.item_count > 0 %}{{ cart.item_count }}{% endif %}</span>
      </a>
      {%- if section.settings.show_cta and section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}" class="btn btn--primary header__cta">{{ section.settings.cta_label | escape }}</a>
      {%- endif -%}
    </div>
  </div>
</header>

{%- comment -%} Mobile menu {%- endcomment -%}
<dialog id="MenuDrawer" class="drawer drawer--left" aria-label="{{ 'general.menu.label' | t }}">
  <div class="drawer__overlay" data-drawer-close></div>
  <div class="drawer__panel">
    <div class="drawer__header">
      <a href="{{ routes.root_url }}" class="header__logo" style="position:static; transform:none;">
        {%- if settings.show_logo_mark -%}{% render 'icon', name: 'logo-mark', class: 'logo-mark' %}{%- endif -%}
        <span class="wordmark">{{ brand | escape }}</span>
      </a>
      <button type="button" class="drawer__close" data-drawer-close aria-label="{{ 'general.menu.close' | t }}">{% render 'icon', name: 'close' %}</button>
    </div>
    <nav class="menu-drawer__nav" aria-label="Mobile">
      <ul class="menu-drawer__list" role="list">
        {%- if menu.links.size > 0 -%}
          {%- for link in menu.links -%}
            <li>
              {%- if link.links.size > 0 -%}
                <details>
                  <summary><span class="menu-drawer__index">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>{{ link.title | escape }}</summary>
                  <ul class="menu-drawer__sub" role="list">
                    <li><a href="{{ link.url }}">{{ 'general.view_all' | t }}</a></li>
                    {%- for child in link.links -%}<li><a href="{{ child.url }}">{{ child.title | escape }}</a></li>{%- endfor -%}
                  </ul>
                </details>
              {%- else -%}
                <a href="{{ link.url }}"><span class="menu-drawer__index">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>{{ link.title | escape }}</a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        {%- else -%}
          {%- for item in fallback_links -%}
            {%- assign parts = item | split: '|' -%}
            <li><a href="{{ parts[0] }}"><span class="menu-drawer__index">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>{{ parts[1] }}</a></li>
          {%- endfor -%}
        {%- endif -%}
      </ul>
      <div class="menu-drawer__utility">
        <button type="button" class="btn btn--secondary" data-drawer-open="SearchModal">{% render 'icon', name: 'search', class: 'icon-arrow' %} {{ 'general.search.label' | t }}</button>
        {%- if shop.customer_accounts_enabled -%}
          <a href="{{ routes.account_url }}" class="btn btn--secondary">{% render 'icon', name: 'account', class: 'icon-arrow' %} {{ 'general.account' | t }}</a>
        {%- endif -%}
      </div>
      {%- if section.settings.show_cta and section.settings.cta_label != blank -%}
        <div class="menu-drawer__cta">
          <a href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}" class="btn btn--primary btn--lg btn--block">
            {{ section.settings.cta_label | escape }} {% render 'icon', name: 'arrow', class: 'icon-arrow' %}
          </a>
        </div>
      {%- endif -%}
    </nav>
  </div>
</dialog>

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu",
      "info": "Suggested: Shop, Sleep, Organize, Bundles, About, FAQ. Build it in Online Store → Navigation."
    },
    { "type": "checkbox", "id": "overlay_on_home", "label": "Transparent over the home page hero", "default": true },
    { "type": "checkbox", "id": "show_cta", "label": "Show button", "default": true },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop the collection" },
    { "type": "url", "id": "cta_link", "label": "Button link", "info": "Defaults to all products." }
  ]
}
{% endschema %}
