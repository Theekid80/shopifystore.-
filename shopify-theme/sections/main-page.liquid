{%- comment -%}
  Page content from Online Store → Pages. Legal/policy text must be your
  own finalized wording — the theme never invents it.
{%- endcomment -%}
<div class="page-width page-width--narrow section section--tight">
  <header class="page-header" style="padding-top:0;">
    {%- if section.settings.show_breadcrumbs -%}{% render 'breadcrumbs' %}{%- endif -%}
    <h1 class="h-headline">{{ page.title | escape }}</h1>
  </header>
  <div class="rte" style="font-size: 1.0625rem;">
    {%- if page.content != blank -%}
      {{ page.content }}
    {%- else -%}
      <p class="placeholder-block">[Add this page's content in Online Store → Pages.]</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Page",
  "class": "section-main-page",
  "settings": [{ "type": "checkbox", "id": "show_breadcrumbs", "label": "Show breadcrumbs", "default": false }]
}
{% endschema %}
