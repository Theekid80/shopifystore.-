{%- liquid
  assign product = section.settings.product
  if product == blank and section.settings.product_handle != blank
    assign product = all_products[section.settings.product_handle]
  endif
  assign scheme = section.settings.color_scheme
-%}
<section id="{{ section.settings.anchor | default: 'featured' }}" class="section {{ scheme }}" data-product-section aria-labelledby="FeaturedTitle-{{ section.id }}">
  <div class="page-width">
    {%- if product != blank and product.title != blank -%}
      {% render 'product-json', product: product %}
      <div class="product">
        <div class="product__media-col reveal">
          {% render 'product-media-gallery', product: product, section_id: section.id %}
        </div>
        <div class="product__info reveal" style="--delay: 100ms;">
          {%- if section.settings.eyebrow != blank -%}<p class="eyebrow accent">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
          <h2 id="FeaturedTitle-{{ section.id }}" class="product__title"><a href="{{ product.url }}">{{ product.title | escape }}</a></h2>
          {% render 'price', product: product, size: 'lg' %}
          {%- if product.metafields.custom.short_description != blank -%}
            <p class="product__short">{{ product.metafields.custom.short_description.value | escape }}</p>
          {%- elsif product.description != blank -%}
            <p class="product__short">{{ product.description | strip_html | truncatewords: 40 }}</p>
          {%- endif -%}
          <hr class="product__divider">
          {%- capture contents -%}{% render 'bundle-contents', product: product %}{%- endcapture -%}
          {%- if contents != blank -%}
            <div>
              <p class="eyebrow muted" style="margin-bottom: 1rem;">{{ 'products.product.whats_included' | t }}</p>
              {{ contents }}
            </div>
          {%- endif -%}
          {% render 'product-form', product: product, section_id: section.id %}
          <a href="{{ product.url }}" class="link-arrow">{{ 'products.product.view_product' | t }} {% render 'icon', name: 'arrow', class: 'icon-arrow' %}</a>
        </div>
      </div>
    {%- else -%}
      {%- comment -%} Before the product exists in Shopify: an editorial preview (no price, no buy button). {%- endcomment -%}
      <div class="iwt">
        <div class="iwt__media reveal">
          <div class="media media--lg media--gallery">
            {%- render 'responsive-image', image: section.settings.fallback_image, fallback_asset: 'concept-whats-included.jpg', fallback_alt: 'Concept flat lay of the VELARA Travel Sleep System pieces', sizes: '(min-width: 990px) 50vw, 100vw' -%}
          </div>
        </div>
        <div class="iwt__text reveal" style="--delay: 100ms;">
          {%- if section.settings.eyebrow != blank -%}<p class="eyebrow accent">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
          <h2 id="FeaturedTitle-{{ section.id }}" class="h-headline">{{ section.settings.fallback_heading | escape }}</h2>
          <p class="lede">{{ section.settings.fallback_text | escape }}</p>
          <div class="prelaunch-note stack-sm">
            <p class="eyebrow accent">{{ settings.prelaunch_button_label | default: 'Coming soon' }}</p>
            <p>{{ settings.prelaunch_message }}</p>
            {%- form 'customer', id: 'FeaturedNotify' -%}
              <input type="hidden" name="contact[tags]" value="notify,notify-system">
              <input type="hidden" name="contact[accepts_marketing]" value="true">
              {%- if form.posted_successfully? -%}
                <p class="form-message" role="status" data-newsletter-success>{{ 'general.newsletter.success' | t }}</p>
              {%- else -%}
                <div class="field-inline">
                  <label class="visually-hidden" for="FeaturedNotifyEmail">{{ 'general.newsletter.label' | t }}</label>
                  <input id="FeaturedNotifyEmail" type="email" name="contact[email]" autocomplete="email" placeholder="{{ 'general.newsletter.placeholder' | t }}" required>
                  <button type="submit" class="btn btn--primary">{{ 'products.product.notify_me' | t }}</button>
                </div>
              {%- endif -%}
            {%- endform -%}
          </div>
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured product",
  "class": "section-featured-product",
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    {
      "type": "text",
      "id": "product_handle",
      "label": "…or product handle",
      "default": "velara-travel-sleep-system",
      "info": "Used when no product is picked above."
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The flagship" },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Background",
      "options": [
        { "value": "bg-base", "label": "Ivory" },
        { "value": "bg-surface", "label": "Off-white" }
      ],
      "default": "bg-base"
    },
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "system", "info": "Lets links like /#system scroll here." },
    { "type": "header", "content": "Before the product exists" },
    { "type": "image_picker", "id": "fallback_image", "label": "Image" },
    { "type": "text", "id": "fallback_heading", "label": "Heading", "default": "The VELARA Travel Sleep System" },
    {
      "type": "textarea",
      "id": "fallback_text",
      "label": "Text",
      "default": "Sleep comfort and travel organization, brought together in one coordinated set — designed for airplanes, hotels, road trips and weekends away."
    }
  ],
  "presets": [{ "name": "Featured product" }]
}
{% endschema %}
