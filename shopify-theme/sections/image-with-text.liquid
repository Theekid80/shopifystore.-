{%- comment -%}
  Editorial image + text. Blocks: "point" (small cards) or "step" (numbered list).
  Used for Why VELARA, Not just a sleep mask, Arrive. Unpack. Reset., About.
{%- endcomment -%}
{%- assign fallback = section.settings.fallback_image -%}
{%- if fallback == 'none' -%}{%- assign fallback = blank -%}{%- endif -%}
<section id="{{ section.settings.anchor }}" class="section {{ section.settings.color_scheme }}" aria-labelledby="Iwt-{{ section.id }}">
  <div class="page-width">
    <div class="iwt{% if section.settings.layout == 'image_right' %} iwt--reverse{% endif %}">
      <div class="iwt__media reveal">
        <div class="media media--lg media--{{ section.settings.ratio }}">
          {%- render 'responsive-image', image: section.settings.image, fallback_asset: fallback, fallback_alt: section.settings.image_alt, sizes: '(min-width: 990px) 50vw, 100vw' -%}
        </div>
        {%- if section.settings.inset_image != blank or section.settings.inset_fallback != 'none' -%}
          <div class="iwt__inset media media--square">
            {%- assign inset_fb = section.settings.inset_fallback -%}
            {%- if inset_fb == 'none' -%}{%- assign inset_fb = blank -%}{%- endif -%}
            {%- render 'responsive-image', image: section.settings.inset_image, fallback_asset: inset_fb, alt: '', sizes: '160px' -%}
          </div>
        {%- endif -%}
      </div>
      <div class="iwt__text reveal" style="--delay: 100ms;">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow accent">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 id="Iwt-{{ section.id }}" class="h-headline">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.lead != blank -%}<p class="iwt__lead">{{ section.settings.lead | escape }}</p>{%- endif -%}
        {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}

        {%- assign points = section.blocks | where: 'type', 'point' -%}
        {%- assign steps = section.blocks | where: 'type', 'step' -%}
        {%- if points.size > 0 -%}
          <ul class="points" role="list">
            {%- for block in points -%}
              <li class="point" {{ block.shopify_attributes }}>
                <h3 class="eyebrow">{{ block.settings.title | escape }}</h3>
                <p>{{ block.settings.text | escape }}</p>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
        {%- if steps.size > 0 -%}
          <ol class="steps" role="list">
            {%- for block in steps -%}
              <li {{ block.shopify_attributes }}>
                <span class="steps__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
                <div>
                  <h3 class="eyebrow">{{ block.settings.title | escape }}</h3>
                  <p>{{ block.settings.text | escape }}</p>
                </div>
              </li>
            {%- endfor -%}
          </ol>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn btn--primary" style="margin-top: 2.5rem;">{{ section.settings.button_label | escape }} {% render 'icon', name: 'arrow', class: 'icon-arrow' %}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with text",
  "class": "section-image-with-text",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_alt", "label": "Concept image description (alt)", "default": "An open suitcase packed with travel organizers" },
    {
      "type": "select",
      "id": "fallback_image",
      "label": "Concept image (until you pick one)",
      "options": [
        { "value": "concept-suitcase-organized.jpg", "label": "Packed suitcase" },
        { "value": "concept-travel-system.jpg", "label": "Hotel" },
        { "value": "concept-whats-included.jpg", "label": "Flat lay" },
        { "value": "concept-airplane-lifestyle.jpg", "label": "In flight" },
        { "value": "concept-hero-travel.jpg", "label": "Airport window" },
        { "value": "none", "label": "None" }
      ],
      "default": "concept-suitcase-organized.jpg"
    },
    { "type": "image_picker", "id": "inset_image", "label": "Small inset image" },
    {
      "type": "select",
      "id": "inset_fallback",
      "label": "Inset concept image",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "concept-sleep-mask.jpg", "label": "Sleep mask" },
        { "value": "concept-road-trip-lifestyle.jpg", "label": "Pouch" }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Image shape",
      "options": [
        { "value": "landscape", "label": "Landscape" },
        { "value": "gallery", "label": "Near square" },
        { "value": "tall", "label": "Portrait" }
      ],
      "default": "landscape"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Image position",
      "options": [
        { "value": "image_left", "label": "Left" },
        { "value": "image_right", "label": "Right" }
      ],
      "default": "image_left"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Travel should feel this good." },
    { "type": "textarea", "id": "lead", "label": "Lead (serif)" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "anchor", "label": "Anchor id" },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Background",
      "options": [
        { "value": "bg-base", "label": "Ivory" },
        { "value": "bg-surface", "label": "Off-white" },
        { "value": "color-dark", "label": "Dark" }
      ],
      "default": "bg-surface"
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    },
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [{ "name": "Image with text" }]
}
{% endschema %}
