{%- comment -%}
  Product page. Every field comes from the Shopify product or its
  metafields; nothing is invented. Missing specifications show a neutral
  "will be published before launch" line instead of made-up values.

  Metafields used (create under Settings → Custom data → Products):
    custom.short_description   single line text
    custom.bundle_components   list of product references (bundles)
    custom.whats_included      multi-line text (fallback for bundles)
    custom.material            single line text
    custom.dimensions          single line text
    custom.weight              single line text
    custom.care                multi-line text
    custom.shipping_note       multi-line text
    custom.product_badge       single line text
    custom.coming_soon         true/false
    custom.concept_imagery     true/false
    custom.lifestyle_images    list of files (images)
{%- endcomment -%}
{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign system = all_products[section.settings.system_handle]
  assign in_system = false
  if system != blank and system.id != product.id
    for c in system.metafields.custom.bundle_components.value
      if c.id == product.id
        assign in_system = true
      endif
    endfor
  endif
-%}
<section class="section section--tight" data-product-section aria-label="{{ product.title | escape }}">
  {% render 'product-json', product: product %}
  <div class="page-width">
    {% render 'breadcrumbs' %}
    <div class="product">
      <div class="product__media-col">
        {% render 'product-media-gallery', product: product, priority: true, section_id: section.id %}
      </div>

      <div class="product__info">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              {% render block %}

            {%- when 'badge' -%}
              <div {{ block.shopify_attributes }}>{% render 'product-badge', product: product, class: 'badge--soft' %}</div>

            {%- when 'title' -%}
              <h1 class="product__title" {{ block.shopify_attributes }}>{{ product.title | escape }}</h1>

            {%- when 'price' -%}
              <div {{ block.shopify_attributes }}>
                {%- liquid
                  assign components = product.metafields.custom.bundle_components.value
                  assign separate_total = 0
                  for c in components
                    assign separate_total = separate_total | plus: c.price
                  endfor
                  if separate_total > current_variant.price and block.settings.show_separate_total
                    assign label = 'products.product.bought_separately' | t
                    render 'price', product: product, variant: current_variant, size: 'lg', compare: separate_total, compare_label: label
                  else
                    render 'price', product: product, variant: current_variant, size: 'lg'
                  endif
                -%}
              </div>

            {%- when 'short_description' -%}
              {%- if product.metafields.custom.short_description != blank -%}
                <p class="product__short" {{ block.shopify_attributes }}>{{ product.metafields.custom.short_description.value | escape }}</p>
              {%- endif -%}

            {%- when 'description' -%}
              {%- if product.description != blank -%}
                <div class="rte" {{ block.shopify_attributes }}>{{ product.description }}</div>
              {%- endif -%}

            {%- when 'buy_buttons' -%}
              <div {{ block.shopify_attributes }}>
                <hr class="product__divider">
                {% render 'product-form', product: product, section_id: section.id, show_buy_now: block.settings.show_dynamic_checkout %}
              </div>

            {%- when 'included' -%}
              {%- capture contents -%}{% render 'bundle-contents', product: product %}{%- endcapture -%}
              {%- if contents != blank -%}
                <div {{ block.shopify_attributes }}>
                  {%- assign included_heading = 'products.product.whats_included' | t -%}
                  <p class="eyebrow muted" style="margin-bottom: 1rem;">{{ block.settings.heading | default: included_heading | escape }}</p>
                  {{ contents }}
                </div>
              {%- endif -%}

            {%- when 'part_of_system' -%}
              {%- if in_system -%}
                <a href="{{ system.url }}" class="prelaunch-note" style="display:flex; gap:1rem; align-items:center;" {{ block.shopify_attributes }}>
                  <span class="included__thumb media" style="width:4rem;">
                    {%- if system.featured_media -%}{{ system.featured_media | image_url: width: 160 | image_tag: loading: 'lazy', alt: '', widths: '80, 160' }}{%- endif -%}
                  </span>
                  <span style="flex:1;">
                    <span class="eyebrow accent" style="display:block;">{{ 'products.product.part_of_system' | t }}</span>
                    <span class="small" style="display:block; margin-top:.25rem;">{{ system.title | escape }}</span>
                  </span>
                  {% render 'icon', name: 'arrow', class: 'icon-arrow' %}
                </a>
              {%- endif -%}

            {%- when 'collapsible' -%}
              {%- capture tab_content -%}
                {%- case block.settings.source -%}
                  {%- when 'details' -%}
                    {%- liquid
                      assign rows = ''
                      if product.metafields.custom.material != blank
                        assign rows = rows | append: 'Material::' | append: product.metafields.custom.material.value | append: '||'
                      endif
                      if product.metafields.custom.dimensions != blank
                        assign rows = rows | append: 'Dimensions::' | append: product.metafields.custom.dimensions.value | append: '||'
                      endif
                      if product.metafields.custom.weight != blank
                        assign rows = rows | append: 'Weight::' | append: product.metafields.custom.weight.value | append: '||'
                      endif
                      if current_variant.sku != blank and block.settings.show_sku
                        assign rows = rows | append: 'SKU::' | append: current_variant.sku | append: '||'
                      endif
                    -%}
                    {%- if rows != blank -%}
                      <dl class="spec-list">
                        {%- assign row_list = rows | split: '||' -%}
                        {%- for row in row_list -%}
                          {%- assign parts = row | split: '::' -%}
                          <div><dt>{{ parts[0] }}</dt><dd>{{ parts[1] | escape }}</dd></div>
                        {%- endfor -%}
                      </dl>
                    {%- else -%}
                      <p>{{ 'products.product.details_pending' | t }}</p>
                    {%- endif -%}
                  {%- when 'care' -%}
                    {%- if product.metafields.custom.care != blank -%}
                      {{ product.metafields.custom.care.value | escape | newline_to_br }}
                    {%- else -%}
                      <p>{{ 'products.product.details_pending' | t }}</p>
                    {%- endif -%}
                  {%- when 'shipping' -%}
                    {%- if product.metafields.custom.shipping_note != blank -%}
                      <p>{{ product.metafields.custom.shipping_note.value | escape | newline_to_br }}</p>
                    {%- else -%}
                      <p>{{ 'products.product.shipping_fallback' | t }}</p>
                    {%- endif -%}
                    {%- if shop.shipping_policy.body != blank -%}<p><a class="link" href="{{ shop.shipping_policy.url }}">{{ shop.shipping_policy.title | escape }}</a></p>{%- endif -%}
                  {%- when 'returns' -%}
                    {%- if shop.refund_policy.body != blank -%}
                      <p><a class="link" href="{{ shop.refund_policy.url }}">{{ shop.refund_policy.title | escape }}</a></p>
                    {%- else -%}
                      <p>{{ 'products.product.returns_fallback' | t }}</p>
                    {%- endif -%}
                  {%- when 'page' -%}
                    {{ block.settings.page.content }}
                  {%- else -%}
                    {{ block.settings.content }}
                {%- endcase -%}
              {%- endcapture -%}
              <div class="accordion accordion--sm" {{ block.shopify_attributes }}>
                <details {% if block.settings.open %}open{% endif %}>
                  <summary>
                    <h2 style="font: inherit;">{{ block.settings.heading | escape }}</h2>
                    <span class="accordion__icon" aria-hidden="true">{% render 'icon', name: 'plus', class: 'icon-arrow' %}</span>
                  </summary>
                  <div class="accordion__content rte">{{ tab_content }}</div>
                </details>
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>

    {%- assign lifestyle = product.metafields.custom.lifestyle_images.value -%}
    {%- if lifestyle.size > 0 -%}
      <ul class="grid mt-lg" role="list" style="--cols-desktop: 2; --cols-tablet: 2;">
        {%- for img in lifestyle limit: 4 -%}
          <li class="reveal"><div class="media media--lg media--landscape">{% render 'responsive-image', image: img, sizes: '(min-width: 750px) 50vw, 100vw' %}</div></li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>

  {%- comment -%} Sticky Add to Cart on phones (hidden while pre-launch / coming soon / sold out). {%- endcomment -%}
  {%- liquid
    assign coming_soon = false
    if product.metafields.custom.coming_soon.value == true or product.tags contains 'coming-soon'
      assign coming_soon = true
    endif
  -%}
  {%- if settings.prelaunch_mode == false and coming_soon == false and product.available and section.settings.sticky_atc -%}
    <div class="sticky-atc" data-sticky-atc data-immediate="true" aria-hidden="true" inert>
      <div class="sticky-atc__inner">
        <span class="sticky-atc__media media">
          {%- if product.featured_media -%}{{ product.featured_media | image_url: width: 120 | image_tag: loading: 'lazy', alt: '', widths: '60, 120' }}{%- endif -%}
        </span>
        <div class="sticky-atc__info">
          <p class="sticky-atc__title">{{ product.title | escape }}</p>
          {% render 'price', product: product, variant: current_variant %}
        </div>
        <button type="button" class="btn btn--primary" data-sticky-atc-submit>{{ 'products.product.add_to_cart' | t }}</button>
      </div>
    </div>
  {%- endif -%}
</section>

{% render 'structured-data-product', product: product %}

{% schema %}
{
  "name": "Product information",
  "class": "section-main-product",
  "settings": [
    { "type": "checkbox", "id": "sticky_atc", "label": "Sticky Add to Cart on phones", "default": true },
    {
      "type": "text",
      "id": "system_handle",
      "label": "Complete system product handle",
      "default": "velara-travel-sleep-system",
      "info": "Pieces listed in this product's bundle_components show a “Part of the system” link."
    }
  ],
  "blocks": [
    { "type": "@app" },
    { "type": "badge", "name": "Badge", "limit": 1, "settings": [] },
    { "type": "title", "name": "Title", "limit": 1, "settings": [] },
    {
      "type": "price",
      "name": "Price",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_separate_total",
          "label": "For bundles, show the separate-items total as the crossed-out price",
          "info": "Uses the live prices of the products in custom.bundle_components.",
          "default": true
        }
      ]
    },
    { "type": "short_description", "name": "Short description", "limit": 1, "settings": [] },
    { "type": "description", "name": "Description", "limit": 1, "settings": [] },
    {
      "type": "buy_buttons",
      "name": "Buy buttons",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show dynamic checkout button (Buy it now / Shop Pay)", "default": true }
      ]
    },
    {
      "type": "included",
      "name": "What's included",
      "limit": 1,
      "settings": [{ "type": "text", "id": "heading", "label": "Heading" }]
    },
    { "type": "part_of_system", "name": "Part of the system", "limit": 1, "settings": [] },
    {
      "type": "collapsible",
      "name": "Collapsible tab",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Details" },
        {
          "type": "select",
          "id": "source",
          "label": "Content",
          "options": [
            { "value": "details", "label": "Specifications (metafields)" },
            { "value": "care", "label": "Care (metafield)" },
            { "value": "shipping", "label": "Shipping (metafield + policy)" },
            { "value": "returns", "label": "Returns (refund policy)" },
            { "value": "page", "label": "A page" },
            { "value": "custom", "label": "Custom text" }
          ],
          "default": "details"
        },
        { "type": "checkbox", "id": "show_sku", "label": "Show SKU (Specifications)", "default": false },
        { "type": "page", "id": "page", "label": "Page" },
        { "type": "richtext", "id": "content", "label": "Custom text" },
        { "type": "checkbox", "id": "open", "label": "Open by default", "default": false }
      ]
    }
  ]
}
{% endschema %}
