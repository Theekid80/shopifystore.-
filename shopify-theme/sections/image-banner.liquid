{%- assign fallback = section.settings.fallback_image -%}
{%- if fallback == 'none' -%}{%- assign fallback = blank -%}{%- endif -%}
<section class="banner color-dark" aria-labelledby="Banner-{{ section.id }}" style="--focal: {{ section.settings.focal }};">
  <div class="banner__media">
    {%- render 'responsive-image', image: section.settings.image, fallback_asset: fallback, fallback_alt: 'A traveler resting in an airplane seat wearing a sleep mask', sizes: '100vw' -%}
  </div>
  <div class="page-width">
    <div class="banner__content reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 id="Banner-{{ section.id }}" class="h-headline">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}<p class="lede">{{ section.settings.text | escape }}</p>{%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn btn--light btn--lg" style="margin-top: 2.25rem;">{{ section.settings.button_label | escape }} {% render 'icon', name: 'arrow', class: 'icon-arrow' %}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image banner",
  "class": "section-image-banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image", "info": "2400px wide or larger." },
    {
      "type": "select",
      "id": "fallback_image",
      "label": "Concept image (until you pick one)",
      "options": [
        { "value": "concept-airplane-lifestyle.jpg", "label": "In flight" },
        { "value": "concept-hero-travel.jpg", "label": "Airport window" },
        { "value": "concept-travel-system.jpg", "label": "Hotel" },
        { "value": "none", "label": "None" }
      ],
      "default": "concept-airplane-lifestyle.jpg"
    },
    {
      "type": "select",
      "id": "focal",
      "label": "Image focus",
      "options": [
        { "value": "30% 50%", "label": "Left" },
        { "value": "50% 50%", "label": "Center" },
        { "value": "65% 50%", "label": "Right" }
      ],
      "default": "65% 50%"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "In the air" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Rest anywhere." },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Long flights, early departures and unfamiliar rooms don't have to mean giving up your routine."
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop sleep" },
    { "type": "url", "id": "button_link", "label": "Button link", "default": "/collections/sleep" }
  ],
  "presets": [{ "name": "Image banner" }]
}
{% endschema %}
