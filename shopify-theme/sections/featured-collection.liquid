{%- comment -%}
  Product grid from a Shopify collection (picked, or found by handle).
  If the collection has no products yet, shows a quiet "coming soon" note
  with an email sign-up instead of empty or fake product cards.
{%- endcomment -%}
{%- liquid
  assign c = section.settings.collection
  if c == blank and section.settings.collection_handle != blank
    assign c = collections[section.settings.collection_handle]
  endif
  assign limit = section.settings.limit
-%}
<section id="{{ section.settings.anchor }}" class="section {{ section.settings.color_scheme }}" aria-labelledby="FeaturedCollection-{{ section.id }}">
  <div class="page-width">
    <div class="section-heading__row">
      <div class="section-heading reveal">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow accent">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 id="FeaturedCollection-{{ section.id }}" class="h-headline">{{ section.settings.heading | default: c.title | escape }}</h2>
        {%- if section.settings.text != blank -%}<p class="lede">{{ section.settings.text | escape }}</p>{%- endif -%}
      </div>
      {%- if c.products_count > 0 and section.settings.show_view_all -%}
        <a href="{{ c.url }}" class="btn btn--secondary reveal">{{ section.settings.view_all_label | escape }} {% render 'icon', name: 'arrow', class: 'icon-arrow' %}</a>
      {%- endif -%}
    </div>

    {%- if c.products_count > 0 -%}
      <ul class="slider-mobile mt-lg" role="list" style="--cols-desktop: {{ section.settings.columns }};">
        {%- for product in c.products limit: limit -%}
          <li class="reveal" style="--delay: {{ forloop.index0 | modulo: 4 | times: 80 }}ms;">
            {% render 'product-card', product: product, section: section %}
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <div class="mt-lg reveal" style="max-width: 32rem;">
        {%- if request.design_mode -%}
          <p class="placeholder-block" style="margin-bottom:1.5rem;">
            Add products to the “{{ section.settings.collection_handle | default: 'selected' }}” collection in Shopify Admin (or pick a collection) and they'll appear here.
          </p>
        {%- endif -%}
        <p class="eyebrow accent">{{ 'general.coming_soon' | t }}</p>
        <p class="muted" style="margin: .75rem 0 1.25rem;">{{ section.settings.empty_text | escape }}</p>
        {%- assign form_id = 'Empty-' | append: section.id -%}
        {%- form 'customer', id: form_id -%}
          <input type="hidden" name="contact[tags]" value="newsletter,interest-{{ section.settings.collection_handle | default: 'collection' }}">
          <input type="hidden" name="contact[accepts_marketing]" value="true">
          {%- if form.posted_successfully? -%}
            <p class="form-message" role="status" data-newsletter-success>{{ 'general.newsletter.success' | t }}</p>
          {%- else -%}
            <div class="field-inline">
              <label class="visually-hidden" for="{{ form_id }}-email">{{ 'general.newsletter.label' | t }}</label>
              <input id="{{ form_id }}-email" type="email" name="contact[email]" autocomplete="email" placeholder="{{ 'general.newsletter.placeholder' | t }}" required>
              <button type="submit" class="btn btn--primary">{{ 'products.product.notify_me' | t }}</button>
            </div>
          {%- endif -%}
        {%- endform -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "class": "section-featured-collection",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "collection_handle", "label": "…or collection handle", "info": "Used when no collection is picked, e.g. sleep, travel-organization, bundles, all." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 6 },
    { "type": "range", "id": "columns", "label": "Columns on desktop", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "checkbox", "id": "show_view_all", "label": "Show “View all” button", "default": true },
    { "type": "text", "id": "view_all_label", "label": "“View all” label", "default": "View all" },
    { "type": "text", "id": "empty_text", "label": "Text while the collection is empty", "default": "This part of the collection is on its way. Join the list to hear first." },
    { "type": "text", "id": "anchor", "label": "Anchor id" },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Background",
      "options": [
        { "value": "bg-base", "label": "Ivory" },
        { "value": "bg-surface", "label": "Off-white" }
      ],
      "default": "bg-base"
    }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
