<div class="page-width section section--tight">
  <header class="page-header" style="padding-top:0;">
    <h1 class="h-headline">{{ section.settings.heading | escape }}</h1>
  </header>
  <ul class="grid" role="list" style="--cols-desktop: 3;">
    {%- for c in collections -%}
      {%- if c.handle != 'build-your-system' -%}
        <li class="reveal">
          <a href="{{ c.url }}" class="category-card">
            <div class="category-card__media">
              {%- render 'responsive-image', image: c.featured_image, fallback_asset: 'concept-whats-included.jpg', alt: '', sizes: '(min-width: 990px) 33vw, 100vw' -%}
            </div>
            <h2 class="h-title category-card__title">{{ c.title | escape }}</h2>
            <span class="link-arrow category-card__link">{{ 'collections.filter.results' | t: count: c.products_count }} {% render 'icon', name: 'arrow', class: 'icon-arrow' %}</span>
          </a>
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
</div>

{% schema %}
{
  "name": "Collections list",
  "class": "section-main-list-collections",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Collections" }]
}
{% endschema %}
