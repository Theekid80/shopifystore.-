{%- comment -%}
  Collection page — /collections/all (Shop), /collections/sleep,
  /collections/travel-organization, /collections/accessories,
  /collections/bundles, …

  Products and filters come from Shopify. Filters are Shopify's storefront
  filtering: enable Availability, Price, Product type and a Category
  filter (e.g. by tag or metafield) in the Search & Discovery app.
{%- endcomment -%}
{%- liquid
  assign per_page = section.settings.per_page
  assign sort_by = collection.sort_by | default: collection.default_sort_by
-%}
<div class="page-width">
  <header class="collection-hero">
    {% render 'breadcrumbs' %}
    {%- if section.blocks.size > 0 -%}
      <nav class="collection-nav" aria-label="Collections">
        {%- for block in section.blocks -%}
          {%- liquid
            assign c = block.settings.collection
            if c == blank and block.settings.handle != blank
              assign c = collections[block.settings.handle]
            endif
            if c.url != blank
              assign href = c.url
            else
              assign href = '/collections/' | append: block.settings.handle
            endif
          -%}
          <a href="{{ href }}" {% if collection.handle == c.handle or collection.handle == block.settings.handle %}aria-current="page"{% endif %} {{ block.shopify_attributes }}>{{ block.settings.label | default: c.title | escape }}</a>
        {%- endfor -%}
      </nav>
    {%- endif -%}
    <h1 class="h-headline">{{ collection.title | escape }}</h1>
    {%- if collection.description != blank -%}
      <div class="lede rte">{{ collection.description }}</div>
    {%- endif -%}
  </header>

  {%- paginate collection.products by per_page -%}
    {%- liquid
      assign show_toolbar = section.settings.enable_sorting
      if section.settings.enable_filtering and collection.filters.size > 0
        assign show_toolbar = true
      endif
    -%}
    {%- if show_toolbar -%}
      <form class="facets" action="{{ collection.url }}" method="get" data-facets-form>
        <div class="facets__filters">
          {%- if section.settings.enable_filtering -%}
            {%- for filter in collection.filters -%}
              <details class="facet">
                <summary>
                  {{ filter.label | escape }}
                  {%- if filter.active_values.size > 0 %} ({{ filter.active_values.size }}){% endif -%}
                  {% render 'icon', name: 'chevron', class: 'icon-arrow' %}
                </summary>
                <div class="facet__panel">
                  {%- case filter.type -%}
                    {%- when 'price_range' -%}
                      <div class="facet__price">
                        <label class="visually-hidden" for="Min-{{ filter.param_name }}">{{ 'collections.filter.from' | t }}</label>
                        <input id="Min-{{ filter.param_name }}" type="number" inputmode="decimal" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}" placeholder="{{ 'collections.filter.from' | t }}" min="0">
                        <span aria-hidden="true">–</span>
                        <label class="visually-hidden" for="Max-{{ filter.param_name }}">{{ 'collections.filter.to' | t }}</label>
                        <input id="Max-{{ filter.param_name }}" type="number" inputmode="decimal" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}" placeholder="{{ filter.range_max | money_without_currency | replace: ',', '' }}" min="0">
                      </div>
                    {%- else -%}
                      <ul role="list">
                        {%- for value in filter.values -%}
                          <li>
                            <label>
                              <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %}>
                              {{ value.label | escape }} <span class="muted">({{ value.count }})</span>
                            </label>
                          </li>
                        {%- endfor -%}
                      </ul>
                  {%- endcase -%}
                  <div class="facet__actions">
                    <a href="{{ filter.url_to_remove }}" class="small link">{{ 'collections.filter.clear' | t }}</a>
                    <button type="submit" class="btn btn--primary">{{ 'collections.filter.apply' | t }}</button>
                  </div>
                </div>
              </details>
            {%- endfor -%}
          {%- endif -%}
        </div>
        {%- if section.settings.enable_sorting -%}
          <div class="facets__sort">
            <label for="SortBy-{{ section.id }}">{{ 'collections.filter.sort_by' | t }}</label>
            <select id="SortBy-{{ section.id }}" name="sort_by" data-sort-select>
              {%- for option in collection.sort_options -%}
                <option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name | escape }}</option>
              {%- endfor -%}
            </select>
            <noscript><button type="submit" class="btn btn--secondary">{{ 'collections.filter.apply' | t }}</button></noscript>
          </div>
        {%- endif -%}
      </form>

      {%- liquid
        assign active_count = 0
        for filter in collection.filters
          assign active_count = active_count | plus: filter.active_values.size
          if filter.type == 'price_range'
            if filter.min_value.value != nil or filter.max_value.value != nil
              assign active_count = active_count | plus: 1
            endif
          endif
        endfor
      -%}
      {%- if active_count > 0 -%}
        <div class="active-filters">
          {%- for filter in collection.filters -%}
            {%- for value in filter.active_values -%}
              <a href="{{ value.url_to_remove }}" aria-label="{{ 'collections.filter.remove' | t: label: value.label | escape }}">{{ value.label | escape }} {% render 'icon', name: 'close', class: 'icon-arrow' %}</a>
            {%- endfor -%}
          {%- endfor -%}
          <a href="{{ collection.url }}?sort_by={{ sort_by }}" class="link small">{{ 'collections.filter.clear_all' | t }}</a>
        </div>
      {%- endif -%}
    {%- endif -%}

    <p class="visually-hidden" role="status">{{ 'collections.filter.results' | t: count: collection.products_count }}</p>

    {%- if collection.products.size > 0 -%}
      <ul class="grid grid--2-mobile" role="list" style="--cols-desktop: {{ section.settings.columns }}; --cols-mobile: {{ section.settings.columns_mobile }};">
        {%- for product in collection.products -%}
          <li class="reveal" style="--delay: {{ forloop.index0 | modulo: 4 | times: 60 }}ms;">
            {%- if section.settings.card_style == 'bundle' -%}
              {% render 'bundle-card', product: product %}
            {%- else -%}
              {% render 'product-card', product: product, section: section, priority: forloop.first %}
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>

      {%- if paginate.pages > 1 -%}
        <nav aria-label="{{ 'general.pagination.label' | t }}">
          <ul class="pagination" role="list">
            {%- if paginate.previous -%}<li><a href="{{ paginate.previous.url }}" aria-label="{{ 'general.pagination.previous' | t }}">←</a></li>{%- endif -%}
            {%- for part in paginate.parts -%}
              <li>
                {%- if part.is_link -%}
                  <a href="{{ part.url }}" aria-label="{{ 'general.pagination.page' | t: number: part.title }}">{{ part.title }}</a>
                {%- elsif part.title == paginate.current_page -%}
                  <span aria-current="page">{{ part.title }}</span>
                {%- else -%}
                  <span>{{ part.title }}</span>
                {%- endif -%}
              </li>
            {%- endfor -%}
            {%- if paginate.next -%}<li><a href="{{ paginate.next.url }}" aria-label="{{ 'general.pagination.next' | t }}">→</a></li>{%- endif -%}
          </ul>
        </nav>
      {%- endif -%}
    {%- else -%}
      <div class="empty-state">
        {%- if active_count > 0 -%}
          <p class="h-title">{{ 'collections.empty_filtered' | t }}</p>
          <a href="{{ collection.url }}" class="btn btn--secondary">{{ 'collections.filter.clear_all' | t }}</a>
        {%- else -%}
          <p class="h-title">{{ 'collections.empty' | t }}</p>
          <a href="#newsletter" class="btn btn--primary">{{ 'products.product.notify_me' | t }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Product grid",
  "class": "section-main-collection",
  "settings": [
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 24 },
    { "type": "range", "id": "columns", "label": "Columns on desktop", "min": 2, "max": 4, "step": 1, "default": 3 },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on phones",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "1"
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "Card style",
      "options": [
        { "value": "product", "label": "Product card" },
        { "value": "bundle", "label": "Bundle card" }
      ],
      "default": "product"
    },
    { "type": "checkbox", "id": "enable_filtering", "label": "Enable filters", "default": true, "info": "Configure filters in the Search & Discovery app." },
    { "type": "checkbox", "id": "enable_sorting", "label": "Enable sorting", "default": true }
  ],
  "blocks": [
    {
      "type": "collection_link",
      "name": "Collection link",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "handle", "label": "…or handle" },
        { "type": "text", "id": "label", "label": "Label" }
      ]
    }
  ]
}
{% endschema %}
