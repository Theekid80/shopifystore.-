{%- comment -%}
  Pre-launch password page (Online Store → Preferences → Password protection).
  Visitors can join the list; you can enter the store with the password.
{%- endcomment -%}
{%- assign brand = settings.brand_name | default: shop.name -%}
<div class="hero color-dark" style="min-height: 100svh;">
  <div class="hero__media">
    {%- render 'responsive-image', image: section.settings.image, fallback_asset: 'concept-hero-travel.jpg', fallback_alt: '', alt: '', sizes: '100vw', priority: true -%}
  </div>
  <div class="page-width hero__content" style="padding-top: 3rem;">
    <div class="hero__text">
      <p class="header__logo" style="position:static; transform:none; color:#fff;">
        {%- if settings.show_logo_mark -%}{% render 'icon', name: 'logo-mark', class: 'logo-mark' %}{%- endif -%}
        <span class="wordmark">{{ brand | escape }}</span>
      </p>
      <h1 class="h-display">{{ section.settings.heading | escape }}</h1>
      <p class="hero__subtitle">{{ shop.password_message | default: section.settings.text | escape }}</p>
      {%- form 'customer', id: 'PasswordNewsletter' -%}
        <input type="hidden" name="contact[tags]" value="newsletter,prelaunch">
        <input type="hidden" name="contact[accepts_marketing]" value="true">
        {%- if form.posted_successfully? -%}
          <p class="form-message" role="status" data-newsletter-success>{{ 'general.newsletter.success' | t }}</p>
        {%- else -%}
          <div class="field-inline" style="max-width: 28rem; background: rgba(255,255,255,.06); border-color: rgba(255,255,255,.25);">
            <label class="visually-hidden" for="PasswordNewsletterEmail">{{ 'general.newsletter.label' | t }}</label>
            <input id="PasswordNewsletterEmail" type="email" name="contact[email]" autocomplete="email" placeholder="{{ 'general.newsletter.placeholder' | t }}" required style="color:#fff;">
            <button type="submit" class="btn btn--light">{{ 'general.newsletter.submit' | t }}</button>
          </div>
          {%- if form.errors -%}<p class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
        {%- endif -%}
      {%- endform -%}

      <details style="margin-top: 3rem; max-width: 28rem;">
        <summary class="eyebrow" style="cursor:pointer; color: rgba(255,255,255,.7);">{{ 'templates.password.enter_password' | t }}</summary>
        {%- form 'storefront_password', id: 'StorefrontPassword' -%}
          <div class="field-inline" style="margin-top:1rem; background: rgba(255,255,255,.06); border-color: rgba(255,255,255,.25);">
            <label class="visually-hidden" for="StorefrontPasswordInput">{{ 'templates.password.password' | t }}</label>
            <input id="StorefrontPasswordInput" type="password" name="password" autocomplete="current-password" placeholder="{{ 'templates.password.password' | t }}" style="color:#fff;">
            <button type="submit" class="btn btn--light">{{ 'templates.password.enter' | t }}</button>
          </div>
          {%- if form.errors -%}<p class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
        {%- endform -%}
        <p class="xsmall" style="margin-top:.75rem; color: rgba(255,255,255,.6);">{{ 'templates.password.owner' | t }} <a class="link" href="/admin">{{ 'templates.password.login_here' | t }}</a></p>
      </details>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Password page",
  "class": "section-main-password",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Opening soon." },
    { "type": "textarea", "id": "text", "label": "Text (used if no password message is set)", "default": "Premium travel essentials for rest and organization. Join the list for early access." }
  ]
}
{% endschema %}
