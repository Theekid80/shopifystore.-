{%- liquid
  assign featured = section.settings.product
  if featured == blank and section.settings.product_handle != blank
    assign featured = all_products[section.settings.product_handle]
  endif
  assign fallback = section.settings.fallback_image
  if fallback == 'none'
    assign fallback = blank
  endif
-%}
<section class="hero color-dark{% if section.settings.height == 'short' %} hero--short{% endif %}" aria-labelledby="HeroTitle-{{ section.id }}" style="--focal: {{ section.settings.focal }};">
  <div class="hero__media">
    {%- render 'responsive-image',
      image: section.settings.image,
      fallback_asset: fallback,
      fallback_alt: 'VELARA travel essentials beside a carry-on at an airport window at sunset',
      sizes: '100vw',
      priority: true
    -%}
  </div>
  <div class="page-width hero__content">
    <div class="hero__text">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow rise">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h1 id="HeroTitle-{{ section.id }}" class="h-display rise" style="--delay: 120ms;">
        {{ section.settings.heading_1 | escape }}
        {%- if section.settings.heading_2 != blank -%}<br><span class="hero__headline-muted">{{ section.settings.heading_2 | escape }}</span>{%- endif -%}
      </h1>
      {%- if section.settings.subheading != blank -%}
        <p class="hero__subtitle rise" style="--delay: 240ms;">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
      <div class="btn-row rise" style="--delay: 360ms;">
        {%- if section.settings.button_1_label != blank -%}
          <a href="{{ section.settings.button_1_link | default: routes.all_products_collection_url }}" class="btn btn--light btn--lg">
            {{ section.settings.button_1_label | escape }} {% render 'icon', name: 'arrow', class: 'icon-arrow' %}
          </a>
        {%- endif -%}
        {%- if section.settings.button_2_label != blank -%}
          <a href="{{ section.settings.button_2_link | default: '#' }}" class="btn btn--ghost-light btn--lg">{{ section.settings.button_2_label | escape }}</a>
        {%- endif -%}
      </div>
    </div>

    {%- if featured != blank and featured.title != blank -%}
      <a href="{{ featured.url }}" class="hero-card rise" style="--delay: 520ms;">
        <span class="hero-card__media media">
          {%- if featured.featured_media -%}
            {{ featured.featured_media | image_url: width: 240 | image_tag: loading: 'eager', alt: '', widths: '160, 240' }}
          {%- endif -%}
        </span>
        <span style="flex:1; min-width:0;">
          <span class="eyebrow" style="display:block; color: var(--color-accent-light);">{{ section.settings.card_label | escape }}</span>
          <span class="hero-card__title" style="display:block; margin-top:.25rem;">{{ featured.title | escape }}</span>
          <span style="display:block; margin-top:.25rem;">{% render 'price', product: featured %}</span>
        </span>
        {% render 'icon', name: 'arrow', class: 'icon-arrow' %}
      </a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "class": "section-hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image", "info": "2400 × 1500px or larger. Keep the left side calm for the text." },
    {
      "type": "select",
      "id": "fallback_image",
      "label": "Concept image (used until you pick an image)",
      "options": [
        { "value": "concept-hero-travel.jpg", "label": "Airport window" },
        { "value": "concept-airplane-lifestyle.jpg", "label": "In flight" },
        { "value": "concept-travel-system.jpg", "label": "Hotel" },
        { "value": "none", "label": "None" }
      ],
      "default": "concept-hero-travel.jpg"
    },
    {
      "type": "select",
      "id": "focal",
      "label": "Image focus",
      "options": [
        { "value": "30% 50%", "label": "Left" },
        { "value": "50% 50%", "label": "Center" },
        { "value": "65% 50%", "label": "Right" }
      ],
      "default": "65% 50%"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "full", "label": "Full screen" },
        { "value": "short", "label": "Shorter" }
      ],
      "default": "full"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Travel, refined" },
    { "type": "text", "id": "heading_1", "label": "Heading line 1", "default": "Better sleep." },
    { "type": "text", "id": "heading_2", "label": "Heading line 2", "default": "Smoother journeys." },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Premium travel essentials designed to help you rest, reset and stay organized — wherever the journey takes you."
    },
    { "type": "text", "id": "button_1_label", "label": "Primary button", "default": "Shop the collection" },
    { "type": "url", "id": "button_1_link", "label": "Primary button link", "info": "Defaults to all products." },
    { "type": "text", "id": "button_2_label", "label": "Secondary button", "default": "Explore the system" },
    { "type": "url", "id": "button_2_link", "label": "Secondary button link", "default": "/products/velara-travel-sleep-system" },
    { "type": "header", "content": "Featured product card (desktop)" },
    { "type": "product", "id": "product", "label": "Product" },
    {
      "type": "text",
      "id": "product_handle",
      "label": "…or product handle",
      "default": "velara-travel-sleep-system",
      "info": "Used when no product is picked above. The card only appears once the product exists."
    },
    { "type": "text", "id": "card_label", "label": "Card label", "default": "The flagship system" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
