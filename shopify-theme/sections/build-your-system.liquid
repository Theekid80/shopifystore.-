{%- comment -%}
  BUILD YOUR TRAVEL SYSTEM

  Data (all from Shopify, nothing hard-coded):
    - Pieces: the "Products" list setting, or else a collection (picked, or
      found by handle, default "build-your-system").
    - "Complete system" comparison: the bundle product's live price.

  "Add system to cart" adds each selected piece as its own line to the
  real Shopify cart via /cart/add.js (tagged with the hidden property
  _system). For a build-your-own discount, create an automatic discount
  in Shopify (Discounts → Automatic → e.g. "buy 3+ items from collection
  build-your-system") and describe it in the "Offer note" setting — the
  discount is then applied by Shopify at checkout. For bundles that must be
  fulfilled as one SKU, use the Shopify Bundles app (see README).

  Until pieces exist in Shopify, the section shows the planned pieces
  (blocks) as a non-purchasable preview.
{%- endcomment -%}
{%- liquid
  assign pieces = section.settings.products
  if pieces == blank or pieces.size == 0
    assign c = section.settings.collection
    if c == blank
      assign c = collections[section.settings.collection_handle]
    endif
    assign pieces = c.products
  endif

  assign bundle = section.settings.bundle
  if bundle == blank and section.settings.bundle_handle != blank
    assign bundle = all_products[section.settings.bundle_handle]
  endif

  assign hide_prices = false
  if settings.prelaunch_mode and settings.prelaunch_hide_prices
    assign hide_prices = true
  endif
  assign has_pieces = false
  if pieces.size > 0
    assign has_pieces = true
  endif
-%}
<section id="{{ section.settings.anchor }}" class="section {{ section.settings.color_scheme }}" aria-labelledby="Bys-{{ section.id }}">
  <div class="page-width">
    <div class="section-heading reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow accent">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 id="Bys-{{ section.id }}" class="h-headline">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}<p class="lede">{{ section.settings.text | escape }}</p>{%- endif -%}
    </div>

    <div
      class="bys mt-lg"
      data-bys
      {% if bundle != blank and bundle.title != blank and hide_prices == false %}data-bundle-price="{{ bundle.price }}"{% endif %}
      data-msg-more="{{ section.settings.msg_more | escape }}"
      data-msg-less="{{ section.settings.msg_less | escape }}"
    >
      <fieldset style="border:0; padding:0; margin:0; min-width:0;">
        <legend class="visually-hidden">{{ section.settings.heading | escape }}</legend>
        <ul class="bys__options" role="list">
          {%- if has_pieces -%}
            {%- for product in pieces limit: 8 -%}
              {%- liquid
                assign v = product.selected_or_first_available_variant
                assign coming = false
                if product.metafields.custom.coming_soon.value == true or product.tags contains 'coming-soon'
                  assign coming = true
                endif
                assign selectable = true
                if coming or product.available == false
                  assign selectable = false
                endif
              -%}
              <li class="reveal" style="--delay: {{ forloop.index0 | times: 60 }}ms;">
                <label class="bys-option">
                  <input
                    type="checkbox"
                    value="{{ v.id }}"
                    data-bys-item
                    data-price="{% unless hide_prices %}{{ v.price }}{% else %}0{% endunless %}"
                    data-title="{{ product.title | escape }}"
                    {% unless selectable %}disabled{% endunless %}
                  >
                  <span class="bys-option__check" aria-hidden="true">{% render 'icon', name: 'check', class: 'icon-arrow' %}</span>
                  <span class="bys-option__media media">
                    {%- if product.featured_media -%}{{ product.featured_media | image_url: width: 160 | image_tag: loading: 'lazy', alt: '', widths: '80, 160' }}{%- endif -%}
                  </span>
                  <span class="bys-option__body">
                    <span class="bys-option__title" style="display:block;">{{ product.title | escape }}</span>
                    <span class="bys-option__text" style="display:block;">
                      {%- if coming -%}{{ 'general.coming_soon' | t }}
                      {%- elsif product.available == false -%}{{ 'products.product.sold_out' | t }}
                      {%- elsif product.metafields.custom.short_description != blank -%}{{ product.metafields.custom.short_description.value | escape }}
                      {%- elsif product.has_only_default_variant == false -%}{{ v.title | escape }}
                      {%- endif -%}
                    </span>
                  </span>
                  <span class="bys-option__price">{% unless hide_prices %}{{ v.price | money }}{% endunless %}</span>
                </label>
              </li>
            {%- endfor -%}
          {%- else -%}
            {%- for block in section.blocks -%}
              <li class="reveal" style="--delay: {{ forloop.index0 | times: 60 }}ms;" {{ block.shopify_attributes }}>
                <label class="bys-option">
                  <input type="checkbox" disabled>
                  <span class="bys-option__check" aria-hidden="true"></span>
                  <span class="bys-option__media media">
                    {%- render 'responsive-image', image: block.settings.image, fallback_asset: block.settings.fallback_image, alt: '', sizes: '64px' -%}
                  </span>
                  <span class="bys-option__body">
                    <span class="bys-option__title" style="display:block;">{{ block.settings.title | escape }}</span>
                    <span class="bys-option__text" style="display:block;">{{ 'general.coming_soon' | t }}</span>
                  </span>
                </label>
              </li>
            {%- endfor -%}
          {%- endif -%}
        </ul>
      </fieldset>

      <aside class="bys__summary reveal" style="--delay: 120ms;" aria-live="polite">
        <p class="eyebrow">{{ section.settings.summary_label | escape }} · <span data-bys-count>0</span></p>
        {%- if has_pieces and hide_prices == false -%}
          <p class="bys__total" data-bys-total>{{ 0 | money }}</p>
        {%- else -%}
          <p class="bys__total" style="font-size: 2rem;">{{ 'products.product.price.pending' | t }}</p>
        {%- endif -%}
        <ul class="bys__selected" data-bys-selected data-empty="{{ section.settings.empty_label | escape }}" role="list"></ul>

        {%- if bundle != blank and bundle.title != blank -%}
          <div class="bys__compare">
            <p class="eyebrow">{{ section.settings.bundle_label | escape }}</p>
            <p>
              <a href="{{ bundle.url }}" class="link" style="color:#fff;">{{ bundle.title | escape }}</a>
              {%- unless hide_prices %} · {{ bundle.price | money }}{% endunless -%}
            </p>
            <p data-bys-compare></p>
          </div>
        {%- endif -%}

        <div style="margin-top: 1.75rem; display:grid; gap:.75rem;">
          {%- if has_pieces and settings.prelaunch_mode == false -%}
            <button type="button" class="btn btn--light btn--lg btn--block" data-bys-add disabled>{{ section.settings.add_label | escape }}</button>
          {%- else -%}
            <button type="button" class="btn btn--light btn--lg btn--block" disabled>{{ settings.prelaunch_button_label | default: 'Coming soon' }}</button>
            <a href="#{{ section.settings.join_anchor | default: 'newsletter' }}" class="btn btn--ghost-light btn--block">{{ section.settings.join_label | escape }}</a>
          {%- endif -%}
          {%- if bundle != blank and bundle.title != blank -%}
            <a href="{{ bundle.url }}" class="btn btn--ghost-light btn--block">{{ section.settings.bundle_cta | escape }}</a>
          {%- endif -%}
        </div>
        <p class="product-form__error" role="alert" data-bys-error hidden style="color:#fca5a5; margin-top:.75rem;"></p>
        {%- if section.settings.offer_note != blank -%}<p class="bys__note">{{ section.settings.offer_note | escape }}</p>{%- endif -%}
      </aside>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Build your system",
  "class": "section-build-your-system",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Build your own" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Build your travel system." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Choose only the pieces you need. Your total updates as you go." },
    { "type": "header", "content": "Pieces" },
    { "type": "product_list", "id": "products", "label": "Products", "limit": 8 },
    { "type": "collection", "id": "collection", "label": "…or a collection" },
    { "type": "text", "id": "collection_handle", "label": "…or collection handle", "default": "build-your-system" },
    { "type": "header", "content": "Complete system comparison" },
    { "type": "product", "id": "bundle", "label": "Complete system product" },
    { "type": "text", "id": "bundle_handle", "label": "…or product handle", "default": "velara-travel-sleep-system" },
    { "type": "text", "id": "bundle_label", "label": "Comparison label", "default": "Complete system" },
    { "type": "text", "id": "bundle_cta", "label": "Comparison button", "default": "View the complete system" },
    { "type": "text", "id": "msg_more", "label": "Message when selection costs more", "default": "Your selection is [amount] more than the complete system." },
    { "type": "text", "id": "msg_less", "label": "Message when selection costs less", "default": "[amount] less than the complete system." },
    { "type": "header", "content": "Summary" },
    { "type": "text", "id": "summary_label", "label": "Summary label", "default": "Your system" },
    { "type": "text", "id": "empty_label", "label": "Empty selection text", "default": "Select pieces to build your system." },
    { "type": "text", "id": "add_label", "label": "Add button", "default": "Add system to cart" },
    { "type": "text", "id": "join_label", "label": "Pre-launch button", "default": "Join the list" },
    { "type": "text", "id": "join_anchor", "label": "Pre-launch button anchor", "default": "newsletter" },
    {
      "type": "text",
      "id": "offer_note",
      "label": "Offer note",
      "info": "Only describe a discount that exists in Shopify → Discounts. Leave empty for none."
    },
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "build" },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Background",
      "options": [
        { "value": "bg-base", "label": "Ivory" },
        { "value": "bg-surface", "label": "Off-white" }
      ],
      "default": "bg-base"
    }
  ],
  "blocks": [
    {
      "type": "planned_piece",
      "name": "Planned piece (preview)",
      "settings": [
        { "type": "paragraph", "content": "Shown only until real products are connected above." },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        {
          "type": "select",
          "id": "fallback_image",
          "label": "Concept image",
          "options": [
            { "value": "concept-sleep-mask.jpg", "label": "Sleep mask" },
            { "value": "concept-road-trip-lifestyle.jpg", "label": "Pouch" },
            { "value": "concept-suitcase-organized.jpg", "label": "Packed suitcase" },
            { "value": "concept-whats-included.jpg", "label": "Flat lay" },
            { "value": "concept-flights-lifestyle.jpg", "label": "Lie-flat seat" }
          ],
          "default": "concept-sleep-mask.jpg"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Build your system",
      "blocks": [
        { "type": "planned_piece", "settings": { "title": "Sleep mask", "fallback_image": "concept-sleep-mask.jpg" } },
        { "type": "planned_piece", "settings": { "title": "Travel pouch", "fallback_image": "concept-road-trip-lifestyle.jpg" } },
        { "type": "planned_piece", "settings": { "title": "Tech organizer", "fallback_image": "concept-suitcase-organized.jpg" } },
        { "type": "planned_piece", "settings": { "title": "Toiletry organizer", "fallback_image": "concept-whats-included.jpg" } },
        { "type": "planned_piece", "settings": { "title": "Packing cube set", "fallback_image": "concept-suitcase-organized.jpg" } }
      ]
    }
  ]
}
{% endschema %}
