{%- comment -%}
  Curated bundles. Each block points at a bundle product in Shopify
  (picked, or found by handle). Until that product exists, the block shows
  an editorial "coming soon" card — no price, no buy button.
{%- endcomment -%}
<section id="{{ section.settings.anchor }}" class="section {{ section.settings.color_scheme }}" aria-labelledby="Bundles-{{ section.id }}">
  <div class="page-width">
    <div class="section-heading__row">
      <div class="section-heading reveal">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow accent">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 id="Bundles-{{ section.id }}" class="h-headline">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}<p class="lede">{{ section.settings.text | escape }}</p>{%- endif -%}
      </div>
      {%- if section.settings.link_label != blank -%}
        <a href="{{ section.settings.link | default: '/collections/bundles' }}" class="btn btn--secondary reveal">{{ section.settings.link_label | escape }} {% render 'icon', name: 'arrow', class: 'icon-arrow' %}</a>
      {%- endif -%}
    </div>

    <ul class="grid mt-lg" role="list" style="--cols-desktop: {{ section.blocks.size | at_most: 3 }};">
      {%- for block in section.blocks -%}
        {%- liquid
          assign p = block.settings.product
          if p == blank and block.settings.product_handle != blank
            assign p = all_products[block.settings.product_handle]
          endif
        -%}
        <li class="reveal" style="--delay: {{ forloop.index0 | times: 90 }}ms;" {{ block.shopify_attributes }}>
          {%- if p != blank and p.title != blank -%}
            {% render 'bundle-card', product: p, featured: block.settings.featured %}
          {%- else -%}
            <article class="bundle-card{% if block.settings.featured %} bundle-card--featured{% endif %}">
              <div class="media media--landscape">
                {%- render 'responsive-image', image: block.settings.image, fallback_asset: block.settings.fallback_image, fallback_alt: '', alt: '', sizes: '(min-width: 990px) 30vw, 90vw' -%}
              </div>
              <div class="bundle-card__body">
                <p class="eyebrow accent">{{ 'general.coming_soon' | t }}</p>
                <h3 class="h-title">{{ block.settings.title | escape }}</h3>
                {%- if block.settings.text != blank -%}<p class="small muted">{{ block.settings.text | escape }}</p>{%- endif -%}
                {%- if block.settings.concept_items != blank -%}
                  <ul class="bundle-card__list" role="list">
                    {%- assign items = block.settings.concept_items | newline_to_br | split: '<br />' -%}
                    {%- for item in items -%}
                      {%- assign it = item | strip -%}
                      {%- if it != blank -%}<li>{% render 'icon', name: 'check' %}{{ it | escape }}</li>{%- endif -%}
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </div>
            </article>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Bundles",
  "class": "section-bundles",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Curated sets" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Better together." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Thoughtfully paired essentials, from a sleep kit to the complete travel sleep system." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "All bundles" },
    { "type": "url", "id": "link", "label": "Link", "info": "Defaults to /collections/bundles." },
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "bundles" },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Background",
      "options": [
        { "value": "bg-base", "label": "Ivory" },
        { "value": "bg-surface", "label": "Off-white" }
      ],
      "default": "bg-surface"
    }
  ],
  "blocks": [
    {
      "type": "bundle",
      "name": "Bundle",
      "settings": [
        { "type": "product", "id": "product", "label": "Bundle product" },
        { "type": "text", "id": "product_handle", "label": "…or product handle", "info": "Used when no product is picked." },
        { "type": "checkbox", "id": "featured", "label": "Emphasize (dark card)", "default": false },
        { "type": "header", "content": "Before the product exists" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Text" },
        { "type": "textarea", "id": "concept_items", "label": "Planned contents (one per line)", "info": "Shown only until the product exists. Keep it general while contents are unconfirmed." },
        { "type": "image_picker", "id": "image", "label": "Image" },
        {
          "type": "select",
          "id": "fallback_image",
          "label": "Concept image",
          "options": [
            { "value": "concept-sleep-mask.jpg", "label": "Sleep mask" },
            { "value": "concept-suitcase-organized.jpg", "label": "Packed suitcase" },
            { "value": "concept-whats-included.jpg", "label": "Flat lay" },
            { "value": "concept-travel-system.jpg", "label": "Hotel" },
            { "value": "concept-flights-lifestyle.jpg", "label": "Lie-flat seat" }
          ],
          "default": "concept-whats-included.jpg"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bundles",
      "blocks": [
        { "type": "bundle", "settings": { "product_handle": "velara-sleep-essentials", "title": "Sleep Essentials", "text": "The rest-anywhere kit.", "concept_items": "Sleep mask\nTravel pouch\nEarplugs", "fallback_image": "concept-flights-lifestyle.jpg" } },
        { "type": "bundle", "settings": { "product_handle": "velara-travel-organization-set", "title": "Travel Organization Set", "text": "A place for everything in your bag.", "concept_items": "Packing cubes\nToiletry organizer\nTech organizer\nTravel pouch", "fallback_image": "concept-suitcase-organized.jpg" } },
        { "type": "bundle", "settings": { "product_handle": "velara-travel-sleep-system", "featured": true, "title": "The Travel Sleep System", "text": "The complete premium set: sleep comfort and organization together.", "fallback_image": "concept-whats-included.jpg" } }
      ]
    }
  ]
}
{% endschema %}
