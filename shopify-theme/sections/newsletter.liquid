{%- comment -%}
  Email sign-up with Shopify's native customer form. Subscribers are saved
  as Shopify customers with email marketing consent (tag "newsletter"),
  which Shopify Email uses directly and Klaviyo / Mailchimp sync via their
  Shopify apps. No third-party endpoint is hard-coded.
{%- endcomment -%}
<section id="{{ section.settings.anchor }}" class="section {{ section.settings.color_scheme }}" aria-labelledby="Newsletter-{{ section.id }}">
  <div class="page-width">
    <div class="newsletter reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow accent">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 id="Newsletter-{{ section.id }}" class="h-headline">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}<p class="lede">{{ section.settings.text | escape }}</p>{%- endif -%}
      {%- assign form_id = 'Newsletter-form-' | append: section.id -%}
      {%- form 'customer', id: form_id -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input type="hidden" name="contact[accepts_marketing]" value="true">
        {%- if form.posted_successfully? -%}
          <p class="form-message" role="status" data-newsletter-success>{{ 'general.newsletter.success' | t }}</p>
        {%- else -%}
          <div class="field-inline">
            <label class="visually-hidden" for="{{ form_id }}-email">{{ 'general.newsletter.label' | t }}</label>
            <input id="{{ form_id }}-email" type="email" name="contact[email]" autocomplete="email" placeholder="{{ 'general.newsletter.placeholder' | t }}" required>
            <button type="submit" class="btn btn--primary">{{ section.settings.button_label | escape }} {% render 'icon', name: 'arrow', class: 'icon-arrow' %}</button>
          </div>
          {%- if form.errors -%}<p class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
        {%- endif -%}
      {%- endform -%}
      <p class="xsmall muted">{{ 'general.newsletter.no_spam' | t }}</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Email sign-up",
  "class": "section-newsletter",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The VELARA list" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Travel better." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Join the list for travel inspiration, product updates and early access." },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Join VELARA" },
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "newsletter" },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Background",
      "options": [
        { "value": "bg-base", "label": "Ivory" },
        { "value": "bg-surface", "label": "Off-white" },
        { "value": "color-dark", "label": "Dark" }
      ],
      "default": "bg-base"
    }
  ],
  "presets": [{ "name": "Email sign-up" }]
}
{% endschema %}
