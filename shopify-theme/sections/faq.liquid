{%- comment -%}
  FAQ accordion (native <details>, keyboard accessible, no JavaScript).
  Keep answers factual: shipping, returns and specifications should say
  exactly what Shopify is configured to do. Placeholders are in [brackets].
{%- endcomment -%}
<section id="{{ section.settings.anchor }}" class="section {{ section.settings.color_scheme }}" aria-labelledby="Faq-{{ section.id }}">
  <div class="page-width two-col">
    <div class="section-heading reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow accent">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      {%- assign tag = section.settings.heading_tag | default: 'h2' -%}
      <{{ tag }} id="Faq-{{ section.id }}" class="h-headline">{{ section.settings.heading | escape }}</{{ tag }}>
      {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
    </div>
    <div class="accordion reveal" style="--delay: 100ms;">
      {%- for block in section.blocks -%}
        <details {% if forloop.first and section.settings.open_first %}open{% endif %} {{ block.shopify_attributes }}>
          <summary>
            <h3 style="font: inherit;">{{ block.settings.question | escape }}</h3>
            <span class="accordion__icon" aria-hidden="true">{% render 'icon', name: 'plus', class: 'icon-arrow' %}</span>
          </summary>
          <div class="accordion__content rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "class": "section-faq",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "FAQ" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions, answered." },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading level",
      "info": "Use H1 when this is the first section on a page (e.g. the FAQ page).",
      "options": [{ "value": "h1", "label": "H1" }, { "value": "h2", "label": "H2" }],
      "default": "h2"
    },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "checkbox", "id": "open_first", "label": "Open the first question", "default": true },
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "faq" },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Background",
      "options": [
        { "value": "bg-base", "label": "Ivory" },
        { "value": "bg-surface", "label": "Off-white" }
      ],
      "default": "bg-surface"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "question", "settings": { "question": "What will VELARA offer?", "answer": "<p>Premium travel essentials for rest and organization — individual pieces, curated bundles and the complete Travel Sleep System.</p>" } },
        { "type": "question", "settings": { "question": "Can I buy pieces individually?", "answer": "<p>Yes. Every piece will be available on its own, in curated bundles, or as the complete system.</p>" } },
        { "type": "question", "settings": { "question": "How does shipping work?", "answer": "<p>[Add shipping regions, costs and delivery times once confirmed.]</p>" } },
        { "type": "question", "settings": { "question": "What is your return policy?", "answer": "<p>[Add your return policy once finalized. It should match Settings → Policies in Shopify.]</p>" } },
        { "type": "question", "settings": { "question": "How should I care for the sleep mask?", "answer": "<p>[Add care instructions once materials are confirmed.]</p>" } }
      ]
    }
  ]
}
{% endschema %}
