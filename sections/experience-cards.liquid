{%- comment -%}
  "Shop by experience": up to four editorial cards (Travel, Sleep, Comfort,
  Leisure …). Each card links to a Shopify collection — picked, or found by
  handle — and is shown only when that collection has products. The section
  is hidden on the live store when no card has a collection with products.
{%- endcomment -%}
{%- capture cards -%}
  {%- assign n = 0 -%}
  {%- for block in section.blocks -%}
    {%- liquid
      assign c = block.settings.collection
      if c == blank and block.settings.collection_handle != blank
        assign handle = block.settings.collection_handle | strip
        assign c = collections[handle]
      endif
      assign img = block.settings.image
      if img == blank
        assign img = c.image | default: c.featured_image
      endif
    -%}
    {%- if c.products_count > 0 -%}
      {%- assign n = n | plus: 1 -%}
      <li class="reveal" style="--delay: {{ n | minus: 1 | times: 100 }}ms;" {{ block.shopify_attributes }}>
        <div class="tile tile--experience">
          <div class="tile__media">
            {%- if img != blank -%}{% render 'responsive-image', image: img, alt: '', sizes: '(min-width: 990px) 25vw, (min-width: 750px) 50vw, 100vw' %}{%- endif -%}
          </div>
          <h3 class="tile__title"><a class="tile__link" href="{{ c.url }}">{{ block.settings.title | default: c.title | escape }}</a></h3>
          {%- if block.settings.text != blank -%}<p class="tile__text">{{ block.settings.text | escape }}</p>{%- endif -%}
          <p class="tile__cta"><span class="link-line" aria-hidden="true">{{ section.settings.cta_label | escape }}</span></p>
        </div>
      </li>
    {%- elsif request.design_mode -%}
      <li {{ block.shopify_attributes }}>
        <div class="tile tile--experience media-empty--dark">
          <h3 class="tile__title">{{ block.settings.title | escape }}</h3>
          <p class="tile__text">Hidden on the live store until the "{{ block.settings.collection_handle | default: block.settings.collection.title }}" collection has products.</p>
        </div>
      </li>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- assign card_count = cards | split: '<li' | size | minus: 1 | at_least: 1 -%}

{%- if cards != blank -%}
  <section class="section {{ section.settings.color_scheme }}" aria-labelledby="Experience-{{ section.id }}">
    <div class="page-width">
      <div class="section-heading reveal" style="margin-bottom: clamp(2.5rem, 5vw, 4rem);">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow muted">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 id="Experience-{{ section.id }}" class="h-headline">{{ section.settings.heading | escape }}</h2>
      </div>
      <ul class="tiles tiles--experience" role="list" style="--cols: {{ card_count }};">{{ cards }}</ul>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Shop by experience",
  "class": "section-experience",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop by experience" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Wherever the journey takes you." },
    { "type": "text", "id": "cta_label", "label": "Card link label", "default": "Explore" },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Background",
      "options": [
        { "value": "bg-base", "label": "Ivory" },
        { "value": "bg-surface", "label": "Stone" }
      ],
      "default": "bg-base"
    }
  ],
  "blocks": [
    {
      "type": "experience",
      "name": "Experience",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Travel" },
        { "type": "textarea", "id": "text", "label": "Text" },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "collection_handle", "label": "…or collection handle", "info": "Used when no collection is picked." },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Defaults to the collection image, then its first product." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by experience",
      "blocks": [
        { "type": "experience", "settings": { "title": "Travel", "text": "Pack smarter. Move easier.", "collection_handle": "travel" } },
        { "type": "experience", "settings": { "title": "Sleep", "text": "Rest wherever you are.", "collection_handle": "sleep" } },
        { "type": "experience", "settings": { "title": "Comfort", "text": "Make every journey more comfortable.", "collection_handle": "comfort" } },
        { "type": "experience", "settings": { "title": "Leisure", "text": "Slow down and enjoy the journey.", "collection_handle": "leisure" } }
      ]
    }
  ]
}
{% endschema %}
