<div class="page-width page-width--narrow section section--tight">
  <h1 class="h-headline">{{ 'customer.reset_password' | t }}</h1>
  <div class="mt-lg">
  {%- form 'reset_customer_password', class: 'form-grid' -%}
    {%- if form.errors -%}<p class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
    <div class="form-field">
      <label for="ResetPassword">{{ 'customer.password' | t }}</label>
      <input id="ResetPassword" type="password" name="customer[password]" autocomplete="new-password" required>
    </div>
    <div class="form-field">
      <label for="ResetPasswordConfirm">{{ 'customer.password' | t }}</label>
      <input id="ResetPasswordConfirm" type="password" name="customer[password_confirmation]" autocomplete="new-password" required>
    </div>
    <div><button type="submit" class="btn btn--primary btn--lg">{{ 'customer.reset_password' | t }}</button></div>
  {%- endform -%}
  </div>
</div>

{% schema %}
{"name": "Customer reset password", "class": "section-main-reset-password", "settings": []}
{% endschema %}
