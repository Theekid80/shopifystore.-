{%- comment -%} Editorial split: a large image beside restrained copy, with an optional inset image. {%- endcomment -%}
<section id="{{ section.settings.anchor }}" class="section {{ section.settings.color_scheme }}" aria-labelledby="Split-{{ section.id }}">
  <div class="page-width">
    <div class="split split--{{ section.settings.layout }}">
      <div class="split__media">
        <div class="media media--{{ section.settings.ratio }} reveal-image reveal">
          {%- if section.settings.image != blank -%}
            {% render 'responsive-image', image: section.settings.image, sizes: '(min-width: 990px) 58vw, 100vw' %}
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
        {%- if section.settings.inset_image != blank -%}
          <div class="split__inset media media--portrait reveal" style="--delay: 250ms;">
            {% render 'responsive-image', image: section.settings.inset_image, sizes: '22vw' %}
          </div>
        {%- endif -%}
      </div>
      <div class="split__text reveal" style="--delay: 150ms;">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow muted">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 id="Split-{{ section.id }}" class="h-headline">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
        {%- if section.settings.link_label != blank -%}
          <p><a class="link-line" href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.link_label | escape }}</a></p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with text",
  "class": "section-image-with-text",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "image_picker", "id": "inset_image", "label": "Inset image (desktop)" },
    {
      "type": "select",
      "id": "ratio",
      "label": "Image shape",
      "options": [
        { "value": "portrait", "label": "Portrait" },
        { "value": "tall", "label": "Tall" },
        { "value": "square", "label": "Square" },
        { "value": "landscape", "label": "Landscape" }
      ],
      "default": "portrait"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "default", "label": "Image left" },
        { "value": "reverse", "label": "Image right" },
        { "value": "even", "label": "Even columns" }
      ],
      "default": "default"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Fewer, better things." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Tell the story behind a piece, a material or a way of living.</p>" },
    { "type": "text", "id": "link_label", "label": "Link label" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "text", "id": "anchor", "label": "Anchor id" },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Background",
      "options": [
        { "value": "bg-base", "label": "Ivory" },
        { "value": "bg-surface", "label": "Stone" },
        { "value": "color-dark", "label": "Charcoal" }
      ],
      "default": "bg-base"
    }
  ],
  "presets": [{ "name": "Image with text" }]
}
{% endschema %}
