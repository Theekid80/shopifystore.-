{%- comment -%}
  "The WEDRA Edit": products from a Shopify collection (defaults to all
  products). With no products yet it shows a quiet note and sign-up on the
  live store, and placeholder cards in the theme editor for layout preview.
{%- endcomment -%}
{%- liquid
  assign c = section.settings.collection
  if c == blank
    assign c = collections[section.settings.collection_handle]
  endif
  assign limit = section.settings.limit
-%}
<section id="{{ section.settings.anchor }}" class="section {{ section.settings.color_scheme }}" aria-labelledby="FeaturedCollection-{{ section.id }}">
  <div class="page-width">
    <div class="section-heading__row">
      <div class="section-heading reveal">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow muted">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 id="FeaturedCollection-{{ section.id }}" class="h-headline">{{ section.settings.heading | default: c.title | escape }}</h2>
        {%- if section.settings.text != blank -%}<p class="lede">{{ section.settings.text | escape }}</p>{%- endif -%}
      </div>
      {%- if c.products_count > 0 and section.settings.view_all_label != blank -%}
        <a href="{{ c.url }}" class="link-line reveal">{{ section.settings.view_all_label | escape }}</a>
      {%- endif -%}
    </div>

    {%- if c.products_count > 0 -%}
      <ul class="slider-mobile mt-lg" role="list" style="--cols-desktop: {{ section.settings.columns }};">
        {%- for product in c.products limit: limit -%}
          <li class="reveal" style="--delay: {{ forloop.index0 | modulo: 4 | times: 90 }}ms;">
            {% render 'product-card', product: product, section: section %}
          </li>
        {%- endfor -%}
      </ul>
    {%- elsif request.design_mode -%}
      <p class="editor-hint mt-lg">Products appear here automatically once they're added in Shopify (or pick a collection in this section).</p>
      <ul class="slider-mobile mt-md" role="list" style="--cols-desktop: {{ section.settings.columns }};">
        {%- for i in (1..section.settings.columns) -%}
          <li>{% render 'product-card', placeholder: true, index: i %}</li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <div class="mt-lg rule-top reveal" style="padding-top: 2.5rem; display: grid; gap: 2rem;">
        <p class="h-subtitle" style="max-width: 32rem;">{{ section.settings.empty_text | escape }}</p>
        <div style="max-width: 28rem;">
          {%- assign form_id = 'Edit-' | append: section.id -%}
          {% render 'signup-form', id: form_id, tags: 'newsletter,first-edit' %}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "class": "section-featured-collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Selected" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The WEDRA Edit" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "collection_handle", "label": "…or collection handle", "default": "all", "info": "\"all\" shows every product. Used only when no collection is picked." },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 8 },
    { "type": "range", "id": "columns", "label": "Columns on desktop", "min": 2, "max": 4, "step": 1, "default": 4 },
    { "type": "text", "id": "view_all_label", "label": "View all label", "default": "View all" },
    { "type": "textarea", "id": "empty_text", "label": "Text while there are no products", "default": "The first edit is being assembled. Leave your email to see it first." },
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "edit" },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Background",
      "options": [
        { "value": "bg-base", "label": "Ivory" },
        { "value": "bg-surface", "label": "Stone" }
      ],
      "default": "bg-base"
    }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
