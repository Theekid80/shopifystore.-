{%- comment -%} /collections — every Shopify collection that has products. {%- endcomment -%}
<div class="page-width section section--tight">
  <header class="collection-hero" style="padding-top: 0;">
    <div class="collection-hero__inner">
      <h1 class="h-display">{{ section.settings.heading | escape }}</h1>
      {%- if section.settings.text != blank -%}<p class="lede">{{ section.settings.text | escape }}</p>{%- endif -%}
    </div>
  </header>
  {%- assign count = 0 -%}
  <ul class="tiles tiles--3" role="list">
    {%- for c in collections -%}
      {%- if c.products_count > 0 and c.handle != 'frontpage' -%}
        {%- assign count = count | plus: 1 -%}
        <li class="reveal" style="--delay: {{ count | minus: 1 | modulo: 3 | times: 100 }}ms;">
          {% render 'collection-tile', collection: c, cta: section.settings.cta_label %}
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
  {%- if count == 0 -%}
    <div class="empty-state">
      <p class="eyebrow muted">{{ 'collections.empty_title' | t }}</p>
      <p class="h-title">{{ 'collections.empty' | t }}</p>
      <div style="max-width: 26rem; margin-inline: auto; text-align: left;">{% render 'signup-form', id: 'CollectionsSignup', tags: 'newsletter' %}</div>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Collections list",
  "class": "section-main-list-collections",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Collections" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Each collection is a small, considered edit." },
    { "type": "text", "id": "cta_label", "label": "Tile link label", "default": "Explore" }
  ]
}
{% endschema %}
