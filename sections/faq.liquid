{%- comment -%}
  FAQ accordion (native <details>, keyboard accessible, no JavaScript).
  Keep answers factual: shipping, returns and payments should say exactly
  what Shopify is configured to do.
{%- endcomment -%}
<section id="{{ section.settings.anchor }}" class="section {{ section.settings.color_scheme }}" aria-labelledby="Faq-{{ section.id }}">
  <div class="page-width two-col">
    <div class="section-heading reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow muted">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      {%- assign tag = section.settings.heading_tag | default: 'h2' -%}
      <{{ tag }} id="Faq-{{ section.id }}" class="h-headline">{{ section.settings.heading | escape }}</{{ tag }}>
      {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
    </div>
    <div class="accordion accordion--lg reveal" style="--delay: 100ms;">
      {%- for block in section.blocks -%}
        <details {% if forloop.first and section.settings.open_first %}open{% endif %} {{ block.shopify_attributes }}>
          <summary>
            <h3 class="accordion__heading">{{ block.settings.question | escape }}</h3>
            <span class="accordion__icon" aria-hidden="true"></span>
          </summary>
          <div class="accordion__content rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "class": "section-faq",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "FAQ" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions, answered." },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading level",
      "info": "Use H1 when this is the first section on a page (e.g. the FAQ page).",
      "options": [{ "value": "h1", "label": "H1" }, { "value": "h2", "label": "H2" }],
      "default": "h2"
    },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "checkbox", "id": "open_first", "label": "Open the first question", "default": true },
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "faq" },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Background",
      "options": [
        { "value": "bg-base", "label": "Ivory" },
        { "value": "bg-surface", "label": "Stone" }
      ],
      "default": "bg-surface"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "question", "settings": { "question": "How much does shipping cost?", "answer": "<p>Shipping options and costs for your address are shown at checkout, before you pay.</p>" } },
        { "type": "question", "settings": { "question": "What is your return policy?", "answer": "<p>Our return policy is published on the <a href=\"/policies/refund-policy\">Returns</a> page.</p>" } },
        { "type": "question", "settings": { "question": "How do I contact you?", "answer": "<p>Write to us through the <a href=\"/pages/contact\">contact page</a>.</p>" } }
      ]
    }
  ]
}
{% endschema %}
