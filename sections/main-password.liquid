{%- comment -%}
  Password page (Online Store → Preferences → Password protection).
  Visitors can join the list; the owner enters with the store password.
{%- endcomment -%}
<div class="hero hero--center{% if section.settings.image == blank %} hero--empty{% endif %}" style="--overlay: .4;">
  {%- if section.settings.image != blank -%}
    <div class="hero__media">{% render 'responsive-image', image: section.settings.image, alt: '', sizes: '100vw', priority: true %}</div>
  {%- endif -%}
  <div class="page-width hero__content" style="padding-top: 4rem;">
    <div class="hero__text" style="max-width: 36rem;">
      <p>{% render 'logo', context: 'dark' %}</p>
      <h1 class="h-display" style="margin-top: 3rem;">{{ section.settings.heading | escape }}</h1>
      <p class="hero__subtitle">{{ shop.password_message | default: section.settings.text | escape }}</p>
      <div style="margin-top: 2.5rem; text-align: left;">
        {% render 'signup-form', id: 'PasswordNewsletter', tags: 'newsletter,prelaunch' %}
      </div>
      <details style="margin-top: 3rem;">
        <summary class="eyebrow" style="cursor:pointer; color: rgba(255,255,255,.7);">{{ 'templates.password.enter_password' | t }}</summary>
        {%- form 'storefront_password', id: 'StorefrontPassword' -%}
          <div class="field-inline" style="margin-top: 1rem; text-align: left;">
            <label class="visually-hidden" for="StorefrontPasswordInput">{{ 'templates.password.password' | t }}</label>
            <input id="StorefrontPasswordInput" type="password" name="password" autocomplete="current-password" placeholder="{{ 'templates.password.password' | t }}">
            <button type="submit">{{ 'templates.password.enter' | t }}</button>
          </div>
          {%- if form.errors -%}<p class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
        {%- endform -%}
        <p class="xsmall" style="margin-top: .75rem; color: rgba(255,255,255,.6);">{{ 'templates.password.owner' | t }} <a class="link" href="/admin">{{ 'templates.password.login_here' | t }}</a></p>
      </details>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Password page",
  "class": "section-main-password",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Opening soon." },
    { "type": "textarea", "id": "text", "label": "Text (used if no password message is set)", "default": "A considered edit for modern life. Leave your email to hear when we open." }
  ]
}
{% endschema %}
