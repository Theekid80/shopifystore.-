{%- comment -%} Brand statement: a large editorial line with a short supporting paragraph. {%- endcomment -%}
<section class="section {{ section.settings.color_scheme }}" aria-labelledby="Statement-{{ section.id }}">
  <div class="page-width">
    <div class="statement{% if section.settings.layout == 'center' %} statement--center{% endif %}">
      <div class="statement__label reveal">
        {%- if section.settings.index != blank -%}<span class="eyebrow muted">{{ section.settings.index | escape }}</span>{%- endif -%}
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
      </div>
      <div class="statement__body">
        {%- assign tag = section.settings.heading_tag | default: 'h2' -%}
        <{{ tag }} id="Statement-{{ section.id }}" class="h-display reveal" style="--delay: 100ms;">{{ section.settings.heading | escape }}</{{ tag }}>
        {%- if section.settings.text != blank -%}
          <p class="statement__text reveal" style="--delay: 200ms;">{{ section.settings.text | escape }}</p>
        {%- endif -%}
        {%- if section.settings.link_label != blank -%}
          <p class="reveal" style="--delay: 300ms;"><a class="link-line" href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.link_label | escape }}</a></p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brand statement",
  "class": "section-statement",
  "settings": [
    { "type": "text", "id": "index", "label": "Index", "default": "01" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The philosophy" },
    { "type": "textarea", "id": "heading", "label": "Headline", "default": "Less noise. Better things." },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading level",
      "info": "Use H1 when this is the first section of a page.",
      "options": [{ "value": "h1", "label": "H1" }, { "value": "h2", "label": "H2" }],
      "default": "h2"
    },
    { "type": "textarea", "id": "text", "label": "Text", "default": "WEDRA brings together distinctive products chosen for design, function, and the way they fit into modern life." },
    { "type": "text", "id": "link_label", "label": "Link label" },
    { "type": "url", "id": "link", "label": "Link" },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [{ "value": "split", "label": "Editorial (label left)" }, { "value": "center", "label": "Centered" }],
      "default": "split"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Background",
      "options": [
        { "value": "bg-base", "label": "Ivory" },
        { "value": "bg-surface", "label": "Stone" },
        { "value": "color-dark", "label": "Charcoal" }
      ],
      "default": "bg-base"
    }
  ],
  "presets": [{ "name": "Brand statement" }]
}
{% endschema %}
