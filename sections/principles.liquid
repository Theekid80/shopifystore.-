{%- comment -%} Numbered principles / values in hairline columns. Keep them to what WEDRA actually does. {%- endcomment -%}
<section class="section {{ section.settings.color_scheme }}"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | handle }}"{% endif %} aria-labelledby="Principles-{{ section.id }}">
  <div class="page-width">
    <div class="section-heading__row reveal" style="margin-bottom: clamp(2.5rem, 5vw, 4rem);">
      <div class="section-heading">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow muted">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 id="Principles-{{ section.id }}" class="h-headline">{{ section.settings.heading | escape }}</h2>
      </div>
    </div>
    <ol class="principles" role="list" style="--cols: {{ section.blocks.size | at_most: 4 | at_least: 1 }};">
      {%- for block in section.blocks -%}
        <li class="principle reveal" style="--delay: {{ forloop.index0 | times: 100 }}ms;" {{ block.shopify_attributes }}>
          <span class="principle__index">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          <h3 class="h-subtitle">{{ block.settings.title | escape }}</h3>
          {%- if block.settings.text != blank -%}<p>{{ block.settings.text | escape }}</p>{%- endif -%}
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "Principles",
  "class": "section-principles",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why WEDRA" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "We search. We filter. You discover." },
    { "type": "text", "id": "anchor", "label": "Anchor id", "info": "Lets a button link here, e.g. #why-wedra." },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Background",
      "options": [
        { "value": "bg-base", "label": "Ivory" },
        { "value": "bg-surface", "label": "Stone" },
        { "value": "color-dark", "label": "Charcoal" }
      ],
      "default": "bg-surface"
    }
  ],
  "blocks": [
    {
      "type": "principle",
      "name": "Principle",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Design" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Principles",
      "blocks": [
        { "type": "principle", "settings": { "title": "Design", "text": "Pieces with presence — considered form, honest materials, nothing added for show." } },
        { "type": "principle", "settings": { "title": "Function", "text": "Everything earns its place by being genuinely useful, day after day." } },
        { "type": "principle", "settings": { "title": "Fit", "text": "Chosen for the way they sit in a modern life — at home, at work, in motion." } }
      ]
    }
  ]
}
{% endschema %}
