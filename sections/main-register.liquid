<div class="page-width page-width--narrow section section--tight">
  <h1 class="h-headline">{{ 'customer.register' | t }}</h1>
  <div class="mt-lg">
  {%- form 'create_customer', novalidate: 'novalidate', class: 'form-grid' -%}
    {%- if form.errors -%}<p class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
    <div class="form-grid form-grid--2">
    <div class="form-field">
      <label for="RegisterFirstName">{{ 'customer.first_name' | t }}</label>
      <input id="RegisterFirstName" type="text" name="customer[first_name]" autocomplete="given-name" >
    </div>
    <div class="form-field">
      <label for="RegisterLastName">{{ 'customer.last_name' | t }}</label>
      <input id="RegisterLastName" type="text" name="customer[last_name]" autocomplete="family-name" >
    </div>
    </div>
    <div class="form-field">
      <label for="RegisterEmail">{{ 'customer.email' | t }}</label>
      <input id="RegisterEmail" type="email" name="customer[email]" autocomplete="email" required>
    </div>
    <div class="form-field">
      <label for="RegisterPassword">{{ 'customer.password' | t }}</label>
      <input id="RegisterPassword" type="password" name="customer[password]" autocomplete="new-password" required>
    </div>
    <div><button type="submit" class="btn btn--primary btn--lg">{{ 'customer.register' | t }}</button></div>
  {%- endform -%}
  </div>
</div>

{% schema %}
{"name": "Customer register", "class": "section-main-register", "settings": []}
{% endschema %}
