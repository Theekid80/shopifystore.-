{%- if section.settings.text != blank -%}
  <div class="announcement" {{ section.shopify_attributes }}>
    <div class="announcement__inner eyebrow">
      {%- if section.settings.link != blank -%}
        <a href="{{ section.settings.link }}">{{ section.settings.text | escape }}</a>
      {%- else -%}
        <p>{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "class": "section-announcement",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "info": "Only mention shipping offers (e.g. free shipping) once they're set up in Settings → Shipping and delivery. Leave empty to hide the bar."
    },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [{ "name": "Announcement bar" }]
}
{% endschema %}
