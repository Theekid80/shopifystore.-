{%- comment -%} Full-bleed editorial image with a short headline and one link. {%- endcomment -%}
{%- assign image = section.settings.image -%}
<section
  class="banner banner--{{ section.settings.height }}{% if section.settings.align == 'center' %} banner--center{% endif %}{% if image == blank %} banner--empty{% endif %}"
  style="--focal: {{ section.settings.focal }}; --overlay: {{ section.settings.overlay | divided_by: 100.0 }};"
  aria-labelledby="Banner-{{ section.id }}"
>
  {%- if image != blank -%}
    <div class="banner__media" data-parallax>{% render 'responsive-image', image: image, sizes: '100vw' %}</div>
  {%- endif -%}
  <div class="page-width banner__content">
    <div class="banner__text">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow reveal">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 id="Banner-{{ section.id }}" class="h-display reveal" style="--delay: 100ms;">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}<p class="lede reveal" style="--delay: 200ms; color: rgba(255,255,255,.84);">{{ section.settings.text | escape }}</p>{%- endif -%}
      {%- if section.settings.link_label != blank -%}
        <p class="reveal" style="--delay: 300ms;"><a class="link-line" href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.link_label | escape }}</a></p>
      {%- endif -%}
      {%- if image == blank and request.design_mode -%}<p class="editor-hint">Add a full-bleed image in this section's settings.</p>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Editorial banner",
  "class": "section-image-banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image", "info": "At least 2400px wide." },
    {
      "type": "select",
      "id": "focal",
      "label": "Image focus",
      "options": [
        { "value": "25% 50%", "label": "Left" },
        { "value": "50% 50%", "label": "Center" },
        { "value": "75% 50%", "label": "Right" }
      ],
      "default": "50% 50%"
    },
    { "type": "range", "id": "overlay", "label": "Image darkening", "min": 0, "max": 70, "step": 5, "unit": "%", "default": 30 },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [{ "value": "full", "label": "Tall" }, { "value": "medium", "label": "Medium" }],
      "default": "full"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Text position",
      "options": [{ "value": "left", "label": "Bottom left" }, { "value": "center", "label": "Center" }],
      "default": "left"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "textarea", "id": "heading", "label": "Headline", "default": "Designed to stand out." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Objects with presence. Essentials with intention." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Discover the edit" },
    { "type": "url", "id": "link", "label": "Link", "info": "Defaults to all products." }
  ],
  "presets": [{ "name": "Editorial banner" }]
}
{% endschema %}
