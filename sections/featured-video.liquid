{%- comment -%}
  Featured product video. Pick a product and the section plays that
  product's first video from its Shopify media (Admin → Products → Media),
  so replacing or reordering the product's media updates it here.
  A video uploaded in the section, or a YouTube/Vimeo link, can be used
  instead. Hidden on the live store when no video is found.
  Videos never play with sound on their own. "Silent preview" plays the
  video muted and looped only while it is on screen, and not at all for
  visitors who ask for reduced motion; the controls stay available.
{%- endcomment -%}
{%- liquid
  assign product = section.settings.product | default: product
  if product == blank
    assign product = collections.all.products.first
  endif
  assign source = 'none'
  if section.settings.video != blank
    assign vid = section.settings.video
    assign source = 'video'
  elsif product != blank
    for m in product.media
      if m.media_type == 'video'
        assign vid = m
        assign source = 'video'
        break
      endif
    endfor
    if source == 'none'
      for m in product.media
        if m.media_type == 'external_video'
          assign ext_media = m
          assign source = 'external_media'
          break
        endif
      endfor
    endif
  endif
  if source == 'none' and section.settings.video_url != blank
    assign ext_url = section.settings.video_url
    assign source = 'url'
  endif

  assign ratio = 1.7778
  if source == 'video'
    assign ratio = vid.aspect_ratio | default: vid.preview_image.aspect_ratio | default: 1.7778
  elsif source == 'external_media'
    assign ratio = ext_media.aspect_ratio | default: 1.7778
  endif
  assign label = section.settings.heading | default: product.title | default: 'Video'
  assign autoplay = section.settings.autoplay
-%}

{%- if source != 'none' or request.design_mode -%}
<section id="{{ section.settings.anchor }}" class="section {{ section.settings.color_scheme }}" aria-labelledby="Video-{{ section.id }}">
  <div class="page-width">
    <div class="split split--{{ section.settings.layout }} feature-video">
      <div class="split__media">
        {%- if source != 'none' -%}
          <div class="video-frame reveal" style="--ar: {{ ratio }};">
            {%- if source == 'video' -%}
              {%- liquid
                if section.settings.poster != blank
                  assign poster = section.settings.poster | image_url: width: 1600
                else
                  assign poster = vid.preview_image | image_url: width: 1600
                endif
              -%}
              <video
                class="video-frame__video"
                playsinline
                controls
                {% if autoplay %}muted loop preload="metadata" data-silent-preview{% else %}preload="none"{% endif %}
                poster="{{ poster }}"
                aria-label="{{ label | escape }}"
              >
                {%- for source in vid.sources -%}
                  {%- if source.format == 'mp4' -%}<source src="{{ source.url }}" type="{{ source.mime_type }}">{%- endif -%}
                {%- endfor -%}
              </video>
            {%- elsif source == 'external_media' -%}
              {{ ext_media | external_video_tag: loading: 'lazy', title: label }}
            {%- else -%}
              {%- if ext_url.type == 'youtube' -%}
                <iframe src="https://www.youtube-nocookie.com/embed/{{ ext_url.id }}?rel=0&playsinline=1{% if autoplay %}&autoplay=1&mute=1&loop=1&playlist={{ ext_url.id }}{% endif %}" title="{{ label | escape }}" loading="lazy" allow="autoplay; encrypted-media; picture-in-picture; fullscreen" allowfullscreen></iframe>
              {%- else -%}
                <iframe src="https://player.vimeo.com/video/{{ ext_url.id }}{% if autoplay %}?autoplay=1&muted=1&loop=1{% endif %}" title="{{ label | escape }}" loading="lazy" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>
              {%- endif -%}
            {%- endif -%}
          </div>
        {%- else -%}
          <div class="media media--portrait media-empty"><p class="editor-hint" style="padding: 1.5rem;">Pick a product that has a video in its media, upload a video, or add a YouTube/Vimeo link.</p></div>
        {%- endif -%}
      </div>
      <div class="split__text reveal" style="--delay: 150ms;">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow muted">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 id="Video-{{ section.id }}" class="h-headline">{{ label | escape }}</h2>
        {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
        {%- if product != blank -%}
          {%- if section.settings.heading != blank -%}<p class="feature-video__product">{{ product.title | escape }}</p>{%- endif -%}
          {%- if section.settings.show_price -%}{% render 'price', product: product, show_from: true %}{%- endif -%}
          {%- if section.settings.link_label != blank and product.url != request.path -%}
            <p><a class="btn" href="{{ product.url }}">{{ section.settings.link_label | escape }}</a></p>
          {%- endif -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Featured video",
  "class": "section-featured-video",
  "settings": [
    { "type": "product", "id": "product", "label": "Product", "info": "Plays this product's first video from its Shopify media. Defaults to the current product, or the store's first live product." },
    { "type": "video", "id": "video", "label": "…or upload a video", "info": "Overrides the product's video." },
    { "type": "video_url", "id": "video_url", "label": "…or YouTube / Vimeo link", "accept": ["youtube", "vimeo"], "info": "Used only when there is no product or uploaded video." },
    { "type": "image_picker", "id": "poster", "label": "Cover image", "info": "Optional. Defaults to the video's own preview frame." },
    { "type": "checkbox", "id": "autoplay", "label": "Silent preview", "default": false, "info": "Plays muted and on a loop while on screen. Visitors can still pause and turn on sound." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "In motion" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Defaults to the product name." },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "checkbox", "id": "show_price", "label": "Show price", "default": true },
    { "type": "text", "id": "link_label", "label": "Button label", "default": "View product", "info": "Leave empty for no button. Hidden on the product's own page." },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "default", "label": "Video left" },
        { "value": "reverse", "label": "Video right" },
        { "value": "even", "label": "Even columns" }
      ],
      "default": "even"
    },
    { "type": "text", "id": "anchor", "label": "Anchor id" },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Background",
      "options": [
        { "value": "bg-base", "label": "Ivory" },
        { "value": "bg-surface", "label": "Stone" },
        { "value": "color-dark", "label": "Charcoal" }
      ],
      "default": "bg-surface"
    }
  ],
  "presets": [{ "name": "Featured video" }]
}
{% endschema %}
