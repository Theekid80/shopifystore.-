{%- comment -%}
  Homepage hero: the brand statement beside a looping carousel.
  Cards come from, in order of preference:
  1. Slide blocks added in the theme editor (e.g. the discovery's ad images);
  2. with a single live product, that product's own images;
  3. otherwise one card per live product (its first image).
  theme.js loops the cards every "interval" seconds. With no cards, only the
  statement shows.
{%- endcomment -%}
{%- liquid
  assign source = section.settings.collection | default: collections.all
  assign overlay = section.settings.overlay | divided_by: 100.0
  assign show_b1 = false
  assign show_b2 = false
  if section.settings.button_1_label != blank
    assign show_b1 = true
  endif
  if section.settings.button_2_label != blank
    assign show_b2 = true
    if section.settings.button_2_link contains '/pages/'
      assign h = section.settings.button_2_link | split: '/pages/' | last | split: '?' | first
      if pages[h].url == blank
        assign show_b2 = false
      endif
    endif
  endif
  assign count = 0
  for product in source.products limit: section.settings.limit
    if product.featured_media != blank
      assign count = count | plus: 1
      if count == 1
        assign first_product = product
      endif
    endif
  endfor
  # only_product is set only when a single product has images.
  if count == 1
    assign only_product = first_product
  endif
  # Card source: slide blocks, else one product's images, else products.
  assign slides = section.blocks | where: 'type', 'slide'
  assign mode = 'products'
  assign cards = count
  if slides.size > 0
    assign mode = 'slides'
    assign cards = 0
    for b in slides
      if b.settings.image != blank
        assign cards = cards | plus: 1
      endif
    endfor
  elsif count == 1 and only_product.images.size > 1
    assign mode = 'images'
    assign cards = only_product.images.size | at_most: section.settings.limit
  endif
  # One discovery: the primary button goes straight to it.
  assign b1_link = section.settings.button_1_link
  if b1_link == blank
    if source.products_count == 1 and only_product != blank
      assign b1_link = only_product.url
    else
      assign b1_link = source.url
    endif
  endif
  if section.settings.color_scheme == 'dark'
    assign b1_class = 'btn--light'
    assign b2_class = 'btn--ghost-light'
  else
    assign b1_class = 'btn--primary'
    assign b2_class = 'btn--secondary'
  endif
-%}
<section
  class="hero hero--{{ section.settings.height }} hero--carousel hero--{{ section.settings.color_scheme | default: 'light' }}"
  style="--overlay: {{ overlay }};"
  aria-labelledby="Hero-{{ section.id }}"
>
  <div class="page-width hero__content hero-carousel__layout">
    <div class="hero__text">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow rise" style="--delay: 150ms;">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 id="Hero-{{ section.id }}" class="display rise" style="--delay: 250ms;">{{ section.settings.heading | escape }}</h1>
      {%- if section.settings.subheading != blank -%}
        <p class="hero__subtitle rise" style="--delay: 450ms;">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
      {%- if show_b1 or show_b2 -%}
        <div class="btn-row rise" style="--delay: 600ms;">
          {%- if show_b1 -%}
            <a href="{{ b1_link }}" class="btn {{ b1_class }} btn--lg">{{ section.settings.button_1_label | escape }}</a>
          {%- endif -%}
          {%- if show_b2 -%}
            <a href="{{ section.settings.button_2_link | default: routes.collections_url }}" class="btn {{ b2_class }} btn--lg">{{ section.settings.button_2_label | escape }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    {%- if cards > 0 -%}
      <div
        class="hero-carousel rise"
        style="--delay: 350ms;"
        role="region"
        aria-roledescription="carousel"
        aria-label="{{ only_product.title | default: source.title | default: 'Products' | escape }}"
        data-hero-carousel
        data-interval="{{ section.settings.interval | times: 1000 }}"
      >
        <ul class="hero-carousel__track" data-track aria-live="off">
          {%- case mode -%}
            {%- when 'slides' -%}
              {%- for block in slides -%}
                {%- if block.settings.image == blank -%}{%- continue -%}{%- endif -%}
                {%- liquid
                  assign slide_link = block.settings.link
                  if slide_link == blank
                    assign slide_link = only_product.url | default: source.url
                  endif
                  assign slide_product_title = ''
                  if slide_link contains '/products/'
                    assign slide_handle = slide_link | split: '/products/' | last | split: '?' | first
                    assign slide_product_title = all_products[slide_handle].title
                  endif
                  assign slide_alt = block.settings.image.alt | default: block.settings.caption | default: slide_product_title | default: only_product.title | default: shop.name
                -%}
                <li class="hero-carousel__card" aria-roledescription="slide" {{ block.shopify_attributes }}>
                  <a href="{{ slide_link }}" class="hero-carousel__link" aria-label="{{ slide_alt | escape }}">
                    <span class="hero-carousel__media">
                      {%- render 'responsive-image', image: block.settings.image, alt: slide_alt, sizes: '(min-width: 990px) 30vw, 70vw', widths: '360, 540, 720, 900, 1080', priority: forloop.first -%}
                    </span>
                    {%- if block.settings.caption != blank -%}<span class="hero-carousel__title">{{ block.settings.caption | escape }}</span>{%- endif -%}
                  </a>
                </li>
              {%- endfor -%}
            {%- when 'images' -%}
              {%- for image in only_product.images limit: section.settings.limit -%}
                {%- assign image_alt = image.alt | default: only_product.title -%}
                <li class="hero-carousel__card" aria-roledescription="slide">
                  <a href="{{ only_product.url }}" class="hero-carousel__link">
                    <span class="hero-carousel__media">
                      {%- render 'responsive-image', image: image, alt: image_alt, sizes: '(min-width: 990px) 30vw, 70vw', widths: '360, 540, 720, 900, 1080', priority: forloop.first -%}
                    </span>
                    {%- if forloop.first -%}<span class="hero-carousel__title">{{ only_product.title | escape }}</span>{%- endif -%}
                  </a>
                </li>
              {%- endfor -%}
            {%- else -%}
              {%- for product in source.products limit: section.settings.limit -%}
                {%- if product.featured_media == blank -%}{%- continue -%}{%- endif -%}
                {%- assign card_alt = product.featured_media.alt | default: product.title -%}
                <li class="hero-carousel__card" aria-roledescription="slide" aria-label="{{ product.title | escape }}">
                  <a href="{{ product.url }}" class="hero-carousel__link">
                    <span class="hero-carousel__media">
                      {%- render 'responsive-image', image: product.featured_media.preview_image, alt: card_alt, sizes: '(min-width: 990px) 30vw, 70vw', widths: '360, 540, 720, 900, 1080', priority: forloop.first -%}
                    </span>
                    <span class="hero-carousel__title">{{ product.title | escape }}</span>
                  </a>
                </li>
              {%- endfor -%}
          {%- endcase -%}
        </ul>
        {%- if cards > 1 -%}
          <button type="button" class="hero-carousel__toggle" data-toggle aria-pressed="false">
            <span class="visually-hidden" data-toggle-label>Pause carousel</span>
            <svg class="hero-carousel__icon-pause" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 1h2v10H3zM7 1h2v10H7z" fill="currentColor"/></svg>
            <svg class="hero-carousel__icon-play" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 1l7 5-7 5z" fill="currentColor"/></svg>
          </button>
        {%- endif -%}
      </div>
    {%- elsif request.design_mode -%}
      <p class="editor-hint">Add slides (for example the discovery's ad images), or they will come from your live products automatically.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero carousel",
  "class": "section-hero",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Products from", "info": "Used when there are no slides. Leave empty for every live product. With one product, its own images loop." },
    { "type": "range", "id": "limit", "label": "Products shown", "min": 2, "max": 24, "step": 1, "default": 12 },
    { "type": "range", "id": "interval", "label": "Seconds per slide", "min": 1, "max": 8, "step": 0.1, "unit": "s", "default": 1.7 },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Background",
      "options": [
        { "value": "light", "label": "Warm white" },
        { "value": "dark", "label": "Charcoal" }
      ],
      "default": "light"
    },
    { "type": "range", "id": "overlay", "label": "Background darkening (charcoal only)", "min": 0, "max": 70, "step": 5, "unit": "%", "default": 0 },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "full", "label": "Full screen" },
        { "value": "medium", "label": "Medium" }
      ],
      "default": "full"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Headline", "default": "Products worth discovering." },
    { "type": "textarea", "id": "subheading", "label": "Supporting text" },
    { "type": "text", "id": "button_1_label", "label": "Primary button", "default": "Explore the discovery" },
    { "type": "url", "id": "button_1_link", "label": "Primary button link", "info": "Defaults to the product when there is only one, otherwise the collection." },
    { "type": "text", "id": "button_2_label", "label": "Secondary button" },
    { "type": "url", "id": "button_2_link", "label": "Secondary button link" }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image", "info": "4:5 portrait works best (1080 × 1350), e.g. a discovery ad." },
        { "type": "text", "id": "caption", "label": "Caption", "info": "Optional small line under the card." },
        { "type": "url", "id": "link", "label": "Link", "info": "Defaults to the product when there is only one, otherwise the collection." }
      ]
    }
  ],
  "presets": [{ "name": "Hero carousel" }]
}
{% endschema %}
