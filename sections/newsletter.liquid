{%- comment -%}
  Email sign-up with Shopify's customer form (saved as subscribed customers,
  tag "newsletter"). Works with Shopify Email; Klaviyo / Mailchimp sync it
  through their Shopify apps. No third-party endpoint is hard-coded.
{%- endcomment -%}
<section id="{{ section.settings.anchor }}" class="section {{ section.settings.color_scheme }}" aria-labelledby="Newsletter-{{ section.id }}">
  <div class="page-width">
    <div class="newsletter reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow muted">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 id="Newsletter-{{ section.id }}" class="h-headline">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}<p class="lede">{{ section.settings.text | escape }}</p>{%- endif -%}
      {%- assign form_id = 'Newsletter-' | append: section.id -%}
      {% render 'signup-form', id: form_id, tags: 'newsletter' %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Email sign-up",
  "class": "section-newsletter",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The WEDRA letter" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Considered, occasionally." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "New arrivals and the thinking behind them. Nothing more." },
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "newsletter" },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Background",
      "options": [
        { "value": "bg-base", "label": "Ivory" },
        { "value": "bg-surface", "label": "Stone" },
        { "value": "color-dark", "label": "Charcoal" }
      ],
      "default": "bg-base"
    }
  ],
  "presets": [{ "name": "Email sign-up" }]
}
{% endschema %}
