<div class="page-width page-width--narrow section section--tight">
  <h1 class="h-headline">{{ 'customer.account' | t }}</h1>
  <p class="muted" style="margin-top:1rem;">{{ customer.name | escape }} · <a class="link" href="{{ routes.account_logout_url }}">{{ 'customer.logout' | t }}</a></p>
  <h2 class="h-title mt-lg">{{ 'customer.orders' | t }}</h2>
  {%- paginate customer.orders by 20 -%}
    {%- if customer.orders.size > 0 -%}
      <div class="table-wrap" style="margin-top:1.5rem;">
        <table class="table">
          <thead><tr><th scope="col">{{ 'customer.order' | t }}</th><th scope="col">{{ 'customer.date' | t }}</th><th scope="col">{{ 'customer.payment_status' | t }}</th><th scope="col">{{ 'customer.fulfillment_status' | t }}</th><th scope="col">{{ 'customer.total' | t }}</th></tr></thead>
          <tbody>
            {%- for order in customer.orders -%}
              <tr>
                <td><a class="link" href="{{ order.customer_url }}">{{ order.name }}</a></td>
                <td>{{ order.created_at | time_tag: format: 'date' }}</td>
                <td>{{ order.financial_status_label }}</td>
                <td>{{ order.fulfillment_status_label }}</td>
                <td>{{ order.total_net_amount | money_with_currency }}</td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </div>
      {%- if paginate.pages > 1 -%}{{ paginate | default_pagination }}{%- endif -%}
    {%- else -%}
      <p class="muted" style="margin-top:1rem;">{{ 'customer.no_orders' | t }}</p>
    {%- endif -%}
  {%- endpaginate -%}
  <h2 class="h-title mt-lg">{{ 'customer.addresses' | t }}</h2>
  {%- if customer.default_address -%}<p class="muted" style="margin-top:1rem;">{{ customer.default_address | format_address }}</p>{%- endif -%}
  <a class="link small" href="{{ routes.account_addresses_url }}">{{ 'customer.view_addresses' | t }}</a>
</div>

{% schema %}
{"name": "Customer account", "class": "section-main-account", "settings": []}
{% endschema %}
