# Copy to .env.local (local) or add in your host's dashboard (Vercel → Settings → Environment Variables).

# Your production URL — used for canonical links, Open Graph and structured data.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Commerce: "mock" (default, no real checkout) or "shopify".
NEXT_PUBLIC_COMMERCE_PROVIDER=mock

# Shopify Storefront API (only needed when provider=shopify).
# Use the PUBLIC Storefront access token — never an Admin API token.
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
NEXT_PUBLIC_SHOPIFY_API_VERSION=2025-10

# Newsletter: URL that accepts POST { "email": "..." } as JSON. Leave empty to disable.
NEXT_PUBLIC_NEWSLETTER_ENDPOINT=
