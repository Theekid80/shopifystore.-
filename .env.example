# Copy to .env.local (local) or add in your host's dashboard (Vercel → Settings → Environment Variables).
# NEXT_PUBLIC_* values are visible in the browser — never put secret keys in them.

# Your production URL — canonical links, Open Graph, structured data, sitemap.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# ── Checkout ────────────────────────────────────────────────────────────────
# "none" (default, preview mode), "shopify" (recommended) or "stripe".
NEXT_PUBLIC_CHECKOUT_PROVIDER=none

# Shopify Storefront API (provider=shopify). PUBLIC Storefront token only.
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
NEXT_PUBLIC_SHOPIFY_API_VERSION=2025-10

# Stripe (provider=stripe). Secret key stays on the server.
STRIPE_SECRET_KEY=
# Flat U.S. shipping in cents for orders under the free-shipping threshold (e.g. 595).
STRIPE_SHIPPING_RATE_CENTS=

# ── Email list ──────────────────────────────────────────────────────────────
# "klaviyo", "mailchimp" or "webhook". Leave empty to keep sign-ups closed.
NEWSLETTER_PROVIDER=
KLAVIYO_PUBLIC_KEY=
KLAVIYO_LIST_ID=
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=
NEWSLETTER_WEBHOOK_URL=

# ── Analytics (each loads only when set) ────────────────────────────────────
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
