[
  {
    "name": "theme_info",
    "theme_name": "WEDRA",
    "theme_version": "2.0.0",
    "theme_author": "WEDRA",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://help.shopify.com/"
  },
  {
    "name": "Brand",
    "settings": [
      {
        "type": "paragraph",
        "content": "The brand name is used across the theme: header wordmark, footer, page titles, social sharing and structured data."
      },
      { "type": "text", "id": "brand_name", "label": "Brand name", "default": "WEDRA" },
      { "type": "text", "id": "brand_tagline", "label": "Tagline", "default": "Less noise. Better things." },
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo image",
        "info": "Optional. Without a logo image, the brand name is set as a typographic wordmark."
      },
      {
        "type": "image_picker",
        "id": "logo_inverse",
        "label": "Logo image on dark backgrounds",
        "info": "Optional light version, used over the homepage hero and in the footer."
      },
      { "type": "range", "id": "logo_width", "label": "Logo width", "min": 60, "max": 240, "step": 4, "unit": "px", "default": 112 },
      { "type": "image_picker", "id": "favicon", "label": "Favicon", "info": "Square PNG, at least 64 × 64px." }
    ]
  },
  {
    "name": "Store status",
    "settings": [
      {
        "type": "paragraph",
        "content": "Pre-launch mode replaces Add to cart and Buy now with a sign-up form, so the store cannot take orders. To hide the whole store before launch, use Online Store → Preferences → Password protection instead."
      },
      { "type": "checkbox", "id": "prelaunch_mode", "label": "Pre-launch mode (no purchases)", "default": false },
      {
        "type": "checkbox",
        "id": "prelaunch_hide_prices",
        "label": "Hide prices during pre-launch",
        "default": true
      },
      { "type": "text", "id": "prelaunch_button_label", "label": "Pre-launch button label", "default": "Coming soon" },
      {
        "type": "text",
        "id": "prelaunch_message",
        "label": "Pre-launch message on product pages",
        "default": "Not yet available. Leave your email and we'll let you know when it is."
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      { "type": "color", "id": "color_background", "label": "Background (ivory)", "default": "#F7F5F0" },
      { "type": "color", "id": "color_surface", "label": "Surface (stone)", "default": "#EDEAE3" },
      { "type": "color", "id": "color_text", "label": "Text (black)", "default": "#111111" },
      { "type": "color", "id": "color_muted", "label": "Secondary text (soft gray)", "default": "#67645E" },
      { "type": "color", "id": "color_dark", "label": "Dark sections (charcoal)", "default": "#161615" },
      { "type": "color", "id": "color_accent", "label": "Accent (neutral)", "default": "#8B867D" },
      { "type": "color", "id": "color_border", "label": "Lines", "default": "#DCD8D0" }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "checkbox",
        "id": "use_brand_fonts",
        "label": "Use WEDRA typefaces (Cormorant Garamond + Manrope)",
        "info": "Bundled with the theme. Turn off to use the fonts picked below.",
        "default": true
      },
      { "type": "font_picker", "id": "type_heading_font", "label": "Display font", "default": "assistant_n4" },
      { "type": "font_picker", "id": "type_body_font", "label": "Text font", "default": "assistant_n4" },
      { "type": "range", "id": "heading_scale", "label": "Display size", "min": 80, "max": 130, "step": 5, "unit": "%", "default": 100 }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart type",
        "options": [
          { "value": "drawer", "label": "Drawer" },
          { "value": "page", "label": "Page" }
        ],
        "default": "drawer"
      },
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Free-shipping threshold (store currency)",
        "info": "Leave empty to hide the progress bar. Only set this once the same rule exists in Settings → Shipping and delivery."
      },
      {
        "type": "text",
        "id": "cart_checkout_note",
        "label": "Note under the checkout button",
        "default": "Shipping and taxes are calculated at checkout."
      },
      { "type": "checkbox", "id": "cart_show_note", "label": "Show order note on cart page", "default": false }
    ]
  },
  {
    "name": "Product cards",
    "settings": [
      {
        "type": "select",
        "id": "card_image_ratio",
        "label": "Image shape",
        "options": [
          { "value": "portrait", "label": "Portrait" },
          { "value": "square", "label": "Square" }
        ],
        "default": "portrait"
      },
      { "type": "checkbox", "id": "card_show_secondary_image", "label": "Show second image on hover", "default": true },
      { "type": "checkbox", "id": "card_show_type", "label": "Show product type above the name", "default": true },
      { "type": "checkbox", "id": "card_show_quick_add", "label": "Show quick add", "default": true },
      { "type": "checkbox", "id": "card_show_swatches", "label": "Show color swatches", "default": true }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      { "type": "paragraph", "content": "Add only accounts that exist. Empty fields are hidden." },
      { "type": "url", "id": "social_instagram_link", "label": "Instagram" },
      { "type": "url", "id": "social_tiktok_link", "label": "TikTok" },
      { "type": "url", "id": "social_pinterest_link", "label": "Pinterest" },
      { "type": "url", "id": "social_facebook_link", "label": "Facebook" },
      { "type": "url", "id": "social_youtube_link", "label": "YouTube" }
    ]
  },
  {
    "name": "Search engine & sharing",
    "settings": [
      {
        "type": "image_picker",
        "id": "share_image",
        "label": "Default social sharing image",
        "info": "1200 × 630px. Used when a page has no image of its own."
      }
    ]
  }
]
