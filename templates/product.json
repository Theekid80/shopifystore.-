{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "badge": { "type": "badge", "settings": {} },
        "brand": { "type": "brand", "settings": { "link": true, "fallback_type": true } },
        "title": { "type": "title", "settings": {} },
        "rating": { "type": "rating", "settings": {} },
        "price": { "type": "price", "settings": {} },
        "short": { "type": "short_description", "settings": {} },
        "buy": { "type": "buy_buttons", "settings": { "show_dynamic_checkout": true } },
        "note": { "type": "note", "settings": { "text": "Shipping options and costs are shown at checkout.", "icon": "box", "link_to": "shipping", "link_label": "Shipping policy" } },
        "brand_info": { "type": "brand_info", "settings": {} },
        "description": { "type": "collapsible", "settings": { "heading": "Description", "source": "description", "open": true } },
        "features": { "type": "collapsible", "settings": { "heading": "Features", "source": "features", "open": false } },
        "included": { "type": "collapsible", "settings": { "heading": "What's included", "source": "whats_included", "open": false } },
        "details": { "type": "collapsible", "settings": { "heading": "Specifications", "source": "details", "show_brand_row": false, "open": false } },
        "shipping": { "type": "collapsible", "settings": { "heading": "Shipping", "source": "shipping", "open": false } },
        "returns": { "type": "collapsible", "settings": { "heading": "Returns", "source": "returns", "open": false } }
      },
      "block_order": ["badge", "brand", "title", "rating", "price", "short", "buy", "note", "brand_info", "description", "features", "included", "details", "shipping", "returns"],
      "settings": { "sticky_atc": true }
    },
    "reviews": { "type": "product-reviews", "settings": {} },
    "related": { "type": "related-products", "settings": { "heading": "Complete your journey", "limit": 4, "color_scheme": "bg-base" } }
  },
  "order": ["main", "reviews", "related"]
}
