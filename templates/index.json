    "discovery": {
      "type": "featured-product",
      "settings": {
        "eyebrow": "WEDRA Discovery #01",
        "heading": "",
        "text": "<p>A compact way to bring your everyday blends wherever your routine takes you. We selected it because it keeps a simple habit simple: a single-serve cup, a rechargeable base and nothing extra to set up.</p>",
        "show_detail": true,
        "show_buy": false,
        "link_label": "Discover the product",
        "layout": "reverse",
        "color_scheme": "bg-surface"
      }
