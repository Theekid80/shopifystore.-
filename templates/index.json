    "why": {
      "type": "principles",
      "blocks": {
        "search": {
          "type": "principle",
          "settings": {
            "title": "We search",
            "text": "We look across a wide range of products for the ones that make everyday life easier, calmer or more enjoyable."
          }
        },
        "filter": {
          "type": "principle",
          "settings": {
            "title": "We filter",
            "text": "Most don't make it. A product earns a place only if it is genuinely useful and easy to understand."
          }
        },
        "discover": {
          "type": "principle",
          "settings": {
            "title": "You discover",
            "text": "We present each one clearly, with real specifications, real photos and a fair price, and nothing invented."
          }
        }
      },
      "block_order": [
        "search",
        "filter",
        "discover"
      ],
      "settings": {
        "eyebrow": "Why WEDRA",
