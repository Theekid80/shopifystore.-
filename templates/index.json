    "philosophy": {
      "type": "statement",
      "settings": {
        "index": "01",
        "eyebrow": "The discovery",
        "heading": "One discovery today. More to come.",
        "heading_size": "headline",
        "heading_tag": "h2",
        "text": "WEDRA is an evolving collection. Each new product is chosen with the same care, and added only when it is worth showing you.",
