        "layout": "split",
        "color_scheme": "color-dark"
      }
    },
    "faq": {
      "type": "faq",
      "blocks": {
        "make": {
          "type": "question",
          "settings": {
            "question": "Does WEDRA make these products?",
            "answer": "<p>No. WEDRA finds and selects products made by others and presents them honestly. We don't put our name on things we didn't make.</p>"
          }
        },
        "choose": {
          "type": "question",
          "settings": {
            "question": "How do you choose what to feature?",
            "answer": "<p>We look for products that are useful in everyday life, easy to understand and fairly priced. We only publish specifications we can confirm.</p>"
          }
        },
        "shipping": {
          "type": "question",
          "settings": {
            "question": "How much does shipping cost?",
            "answer": "<p>Shipping options and costs for your address are shown at checkout, before you pay.</p>"
          }
        },
        "returns": {
          "type": "question",
          "settings": {
            "question": "What is your return policy?",
            "answer": "<p>Our return policy is published on the <a href=\"/policies/refund-policy\">Returns</a> page.</p>"
          }
        },
        "contact": {
          "type": "question",
          "settings": {
            "question": "How do I contact you?",
            "answer": "<p>Write to us through the <a href=\"/pages/contact\">contact page</a>.</p>"
          }
        }
      },
      "block_order": [
        "make",
        "choose",
        "shipping",
        "returns",
        "contact"
      ],
      "settings": {
        "eyebrow": "FAQ",
        "heading": "Questions, answered.",
