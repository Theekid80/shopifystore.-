{%- comment -%}
  Minimal variant data for the variant picker. Deliberately NOT `product | json`,
  which would publish vendor, SKUs, barcodes and tags in the page source.
  Prices are omitted while pre-launch price hiding is on.
{%- endcomment -%}
{%- liquid
  assign hide_prices = false
  if settings.prelaunch_mode and settings.prelaunch_hide_prices
    assign hide_prices = true
  endif
-%}
<script type="application/json" data-product-json>
  {
    "id": {{ product.id | json }},
    "variants": [
      {%- for variant in product.variants -%}
        {
          "id": {{ variant.id | json }},
          "title": {{ variant.title | json }},
          "options": {{ variant.options | json }},
          "available": {{ variant.available | json }},
          {%- unless hide_prices -%}
            "price": {{ variant.price | json }},
            "compare_at_price": {{ variant.compare_at_price | default: 0 | json }},
          {%- endunless -%}
          "featured_media": {% if variant.featured_media %}{ "id": {{ variant.featured_media.id | json }} }{% else %}null{% endif %}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>
