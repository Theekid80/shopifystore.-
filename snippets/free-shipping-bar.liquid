{%- comment -%}
  Shown only when Theme settings → Cart → Free-shipping threshold is set.
  Set it only once the same free-shipping rule exists in Shopify
  (Settings → Shipping and delivery). The threshold is in the store's
  currency; Shopify's checkout is the source of truth.
{%- endcomment -%}
{%- if settings.free_shipping_threshold != blank and settings.free_shipping_threshold > 0 and cart.item_count > 0 -%}
  {%- liquid
    assign threshold_cents = settings.free_shipping_threshold | times: 100
    assign remaining = threshold_cents | minus: cart.total_price
    assign pct = cart.total_price | times: 100 | divided_by: threshold_cents
    if pct > 100
      assign pct = 100
    endif
  -%}
  <div class="free-shipping" role="status">
    {%- if remaining > 0 -%}
      {%- assign remaining_money = remaining | money -%}
      <p>{{ 'cart.free_shipping_remaining' | t: amount: remaining_money }}</p>
    {%- else -%}
      <p>{{ 'cart.free_shipping_reached' | t }}</p>
    {%- endif -%}
    <div class="free-shipping__bar" aria-hidden="true"><span style="width: {{ pct }}%;"></span></div>
  </div>
{%- endif -%}
