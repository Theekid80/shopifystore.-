{%- comment -%}
  Variant picker driven by the product's real options (Color, Size, …).
  Color options render as swatches (Shopify swatch data if set), others as pills.
  Color values that carry more than a colour (e.g. "Pink / USB") render as a
  labelled pill with a colour dot, so similar colours stay distinguishable.
  A value is greyed out only when Shopify has no variant with that value
  available for sale (variant.available, which honours "continue selling
  when out of stock"), never because of the other options currently picked.
  An option fully decided by the others (e.g. a "Size" that is always "New"
  for one colour and "n/a" for the rest) is hidden; theme.js keeps it in
  step so the right variant is always submitted.
  theme.js keeps the form's variant id, price, availability and image in sync.
{%- endcomment -%}
<div class="variant-picker-wrap" data-variant-picker>
  {%- for option in product.options_with_values -%}
    {%- liquid
      assign opt = option.name | downcase
      assign is_color = false
      if opt == 'color' or opt == 'colour'
        assign is_color = true
      endif
      assign idx = option.position | minus: 1

      # Derived option: every combination of the other options maps to one value of this option.
      assign derived = false
      if idx > 0 and product.options.size > 1 and option.values.size > 1
        assign derived = true
        assign seen = '|'
        for v in product.variants
          assign key = ''
          for o in v.options
            if forloop.index0 != idx
              assign key = key | append: o | append: '¦'
            endif
          endfor
          assign pair = key | append: '=>' | append: v.options[idx]
          assign key_marker = '|' | append: key | append: '=>'
          if seen contains key_marker
            assign pair_marker = '|' | append: pair | append: '|'
            unless seen contains pair_marker
              assign derived = false
              break
            endunless
          else
            assign seen = seen | append: pair | append: '|'
          endif
        endfor
      endif

      # Labelled colours: any value naming more than a colour.
      assign labelled = false
      if is_color
        for value in option.values
          if value contains ' / ' or value contains ' ('
            assign labelled = true
            break
          endif
        endfor
      endif
    -%}
    <fieldset class="variant-picker" style="margin-bottom: 1.25rem;" data-option-index="{{ idx }}"{% if derived %} hidden data-derived{% endif %}>
      <legend class="eyebrow muted">
        {{ option.name | escape }}
        <span class="small" style="text-transform:none; letter-spacing:0; color: var(--color-text); margin-left:.5rem;" data-selected-value>{{ option.selected_value | escape }}</span>
      </legend>
      <div class="variant-picker__values">
        {%- for value in option.values -%}
          {%- liquid
            assign input_id = section_id | append: '-' | append: option.position | append: '-' | append: forloop.index
            assign value_available = false
            for v in product.variants
              if v.available and v.options[idx] == value
                assign value_available = true
                break
              endif
            endfor
            if value.swatch.color
              assign swatch = value.swatch.color
            else
              # Colour from the name's base, so "Black (Small)", "Dark Gray + Eye Mask" or "Pink / USB" still get a dot.
              assign base = value | split: ' (' | first | split: ' +' | first | split: ',' | first | split: ' / ' | first | strip
              assign base_down = base | downcase
              if base_down contains 'new '
                assign base = base_down | remove_first: 'new '
              endif
              assign swatch = base | handleize | replace: '-', ''
              case swatch
                when 'navyblue'
                  assign swatch = 'navy'
                when 'rosered'
                  assign swatch = '#c2185b'
                when 'claret'
                  assign swatch = '#7f1734'
                when 'silvery'
                  assign swatch = 'silver'
                when 'pink'
                  assign swatch = '#f2b8b5'
              endcase
            endif
          -%}
          <label class="{% if is_color and labelled %}variant-pill variant-pill--dot{% elsif is_color %}variant-swatch{% else %}variant-pill{% endif %}" for="{{ input_id }}">
            <input
              type="radio"
              id="{{ input_id }}"
              name="{{ section_id }}-{{ option.name | handle }}"
              value="{{ value | escape }}"
              {% if option.selected_value == value %}checked{% endif %}
              {% unless value_available %}class="is-unavailable"{% endunless %}
            >
            {%- if is_color and labelled -%}
              <span><i style="--swatch: {{ swatch }};" aria-hidden="true"></i>{{ value | escape }}</span>
            {%- elsif is_color -%}
              <span style="--swatch: {{ swatch }};" title="{{ value | escape }}"><span class="visually-hidden">{{ value | escape }}</span></span>
            {%- else -%}
              <span>{{ value | escape }}</span>
            {%- endif -%}
          </label>
        {%- endfor -%}
      </div>
    </fieldset>
  {%- endfor -%}
</div>
